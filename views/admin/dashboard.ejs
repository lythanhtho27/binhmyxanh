<!-- 4 Thẻ thống kê tổng quan -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon"><i class="fa-solid fa-coins"></i></div>
    <div>
      <div class="stat-number"><%= Number(stats.totalRevenue).toLocaleString('vi-VN') %>đ</div>
      <div class="stat-label">Tổng doanh thu</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon"><i class="fa-solid fa-receipt"></i></div>
    <div>
      <div class="stat-number"><%= stats.totalOrders %></div>
      <div class="stat-label">Tổng đơn hàng</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon" style="background-color: #fff3e0; color: #f57c00;"><i class="fa-solid fa-clock"></i></div>
    <div>
      <div class="stat-number"><%= stats.pendingOrders %></div>
      <div class="stat-label">Đơn chờ xác nhận</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
    <div>
      <div class="stat-number"><%= stats.totalProducts %></div>
      <div class="stat-label">Sản phẩm trong kho</div>
    </div>
  </div>
</div>

<!-- Đơn hàng gần đây -->
<div class="admin-card">
  <div class="admin-card-header">
    <div class="admin-card-title">
      <i class="fa-solid fa-clock-rotate-left"></i> Đơn Hàng Mới Nhất
    </div>
    <a href="/admin/orders" class="btn-sm btn-outline-sm">Xem tất cả đơn hàng</a>
  </div>

  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Mã đơn</th>
          <th>Khách hàng</th>
          <th>Số điện thoại</th>
          <th>Tổng tiền</th>
          <th>Phương thức</th>
          <th>Trạng thái</th>
          <th>Thời gian</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% if (stats.recentOrders.length === 0) { %>
          <tr>
            <td colspan="8" style="text-align: center; color: var(--admin-muted); padding: 24px;">Chưa có đơn hàng nào được đặt.</td>
          </tr>
        <% } else { %>
          <% stats.recentOrders.forEach(order => { %>
            <tr>
              <td style="font-weight: 700; color: var(--admin-primary);"><%= order.order_code %></td>
              <td><strong><%= order.customer_name %></strong></td>
              <td><%= order.customer_phone %></td>
              <td style="font-weight: 700;"><%= Number(order.total_amount).toLocaleString('vi-VN') %>đ</td>
              <td>
                <%= order.payment_method === 'banking' ? 'Chuyển khoản QR' : 'COD' %>
              </td>
              <td>
                <% if (order.status === 'pending') { %>
                  <span class="badge badge-pending">Chờ xác nhận</span>
                <% } else if (order.status === 'processing') { %>
                  <span class="badge" style="background:#e0f2fe; color:#0369a1;">Đang xử lý</span>
                <% } else if (order.status === 'shipping') { %>
                  <span class="badge badge-shipping">Đang giao</span>
                <% } else if (order.status === 'completed') { %>
                  <span class="badge badge-completed">Hoàn thành</span>
                <% } else { %>
                  <span class="badge badge-cancelled">Đã hủy</span>
                <% } %>
              </td>
              <td style="color: var(--admin-muted); font-size: 0.85rem;">
                <%= new Date(order.created_at).toLocaleDateString('vi-VN') %>
              </td>
              <td>
                <a href="/admin/orders/<%= order.id %>" class="btn-sm btn-outline-sm">Chi tiết</a>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
