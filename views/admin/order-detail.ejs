<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <a href="/admin/orders" class="btn-sm btn-outline-sm" style="margin-bottom: 8px;">
        <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
      </a>
      <h2 class="admin-card-title">
        Chi Tiết Đơn Hàng: <span style="color: var(--admin-primary);"><%= order.order_code %></span>
      </h2>
      <div style="font-size: 0.85rem; color: var(--admin-muted);">
        Đặt lúc: <%= new Date(order.created_at).toLocaleString('vi-VN') %>
      </div>
    </div>

    <div>
      <% if (order.status === 'pending') { %>
        <span class="badge badge-pending" style="font-size: 0.95rem; padding: 6px 14px;">Chờ xác nhận</span>
      <% } else if (order.status === 'processing') { %>
        <span class="badge" style="background:#e0f2fe; color:#0369a1; font-size: 0.95rem; padding: 6px 14px;">Đang xử lý</span>
      <% } else if (order.status === 'shipping') { %>
        <span class="badge badge-shipping" style="font-size: 0.95rem; padding: 6px 14px;">Đang giao hàng</span>
      <% } else if (order.status === 'completed') { %>
        <span class="badge badge-completed" style="font-size: 0.95rem; padding: 6px 14px;">Đã giao thành công</span>
      <% } else { %>
        <span class="badge badge-cancelled" style="font-size: 0.95rem; padding: 6px 14px;">Đã hủy</span>
      <% } %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px; margin-top: 20px;">
    <!-- Cột trái: Thông tin khách hàng & Cập nhật trạng thái -->
    <div>
      <div style="background: #f9fbf9; border: 1px solid var(--admin-border); border-radius: 8px; padding: 20px; margin-bottom: 24px;">
        <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 14px; color: var(--admin-primary);">
          <i class="fa-solid fa-user"></i> Thông tin khách hàng & Giao vận
        </h3>
        <div style="display: flex; flex-direction: column; gap: 8px; font-size: 0.92rem;">
          <div>Họ và tên: <strong><%= order.customer_name %></strong></div>
          <div>Số điện thoại: <strong><%= order.customer_phone %></strong></div>
          <div>Email: <%= order.customer_email || 'Không có' %></div>
          <div>Địa chỉ nhận: <strong><%= order.shipping_address %></strong></div>
          <div>Ghi chú: <em style="color: var(--admin-muted);"><%= order.note || 'Không có' %></em></div>
          <div>Phương thức thanh toán: <strong><%= order.payment_method === 'banking' ? 'Chuyển khoản VietQR' : 'COD (Tiền mặt khi nhận)' %></strong></div>
        </div>
      </div>

      <!-- Form cập nhật trạng thái -->
      <div style="background: white; border: 1.5px solid var(--admin-primary); border-radius: 8px; padding: 20px;">
        <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 16px; color: var(--admin-primary);">
          <i class="fa-solid fa-pen-to-square"></i> Cập Nhật Trạng Thái Đơn Hàng
        </h3>

        <form action="/admin/orders/<%= order.id %>/status" method="POST">
          <div class="form-group">
            <label>Trạng thái xử lý đơn hàng:</label>
            <select name="status" class="form-control" style="font-weight: 600;">
              <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Chờ xác nhận</option>
              <option value="processing" <%= order.status === 'processing' ? 'selected' : '' %>>Đang chuẩn bị hàng</option>
              <option value="shipping" <%= order.status === 'shipping' ? 'selected' : '' %>>Đang giao hàng</option>
              <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>Đã giao thành công</option>
              <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Hủy đơn hàng</option>
            </select>
          </div>

          <div class="form-group">
            <label>Trạng thái thanh toán:</label>
            <select name="payment_status" class="form-control" style="font-weight: 600;">
              <option value="unpaid" <%= order.payment_status === 'unpaid' ? 'selected' : '' %>>Chưa thanh toán</option>
              <option value="paid" <%= order.payment_status === 'paid' ? 'selected' : '' %>>Đã thanh toán thành công</option>
            </select>
          </div>

          <button type="submit" class="btn-sm btn-primary-sm" style="width: 100%; justify-content: center; padding: 12px; font-size: 0.95rem;">
            <i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi trạng thái
          </button>
        </form>
      </div>
    </div>

    <!-- Cột phải: Danh sách sản phẩm trong đơn -->
    <div>
      <div style="background: white; border: 1px solid var(--admin-border); border-radius: 8px; padding: 20px;">
        <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 16px; border-bottom: 1px solid var(--admin-border); padding-bottom: 10px;">
          <i class="fa-solid fa-basket-shopping"></i> Danh sách mặt hàng (<%= order.items ? order.items.length : 0 %>)
        </h3>

        <% if (order.items && order.items.length > 0) { %>
          <div style="display: flex; flex-direction: column; gap: 14px;">
            <% order.items.forEach(item => { %>
              <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; border-bottom: 1px dashed var(--admin-border); padding-bottom: 10px;">
                <img src="<%= item.product_image %>" alt="<%= item.product_name %>" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px;">
                <div style="flex: 1;">
                  <strong style="font-size: 0.92rem;"><%= item.product_name %></strong>
                  <div style="font-size: 0.8rem; color: var(--admin-muted);">
                    <%= Number(item.price).toLocaleString('vi-VN') %>đ × <%= item.quantity %> <%= item.unit %>
                  </div>
                </div>
                <div style="font-weight: 700; color: var(--admin-primary);">
                  <%= Number(item.total_price).toLocaleString('vi-VN') %>đ
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>

        <div style="margin-top: 20px; font-size: 0.92rem; display: flex; flex-direction: column; gap: 8px;">
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--admin-muted);">Tiền hàng:</span>
            <span><%= Number(order.subtotal).toLocaleString('vi-VN') %>đ</span>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--admin-muted);">Phí ship:</span>
            <span><%= Number(order.shipping_fee).toLocaleString('vi-VN') %>đ</span>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 1.15rem; font-weight: 800; border-top: 1.5px dashed var(--admin-border); padding-top: 12px; margin-top: 6px; color: var(--admin-primary);">
            <span>Tổng đơn hàng:</span>
            <span><%= Number(order.total_amount).toLocaleString('vi-VN') %>đ</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
