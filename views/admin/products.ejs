<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <h2 class="admin-card-title"><i class="fa-solid fa-boxes-stacked"></i> Danh Sách Nông Sản (<%= totalProducts %>)</h2>
    </div>
    <button id="btn-open-add-product" class="btn-sm btn-primary-sm" style="padding: 10px 18px; font-size: 0.9rem;">
      <i class="fa-solid fa-plus"></i> Thêm nông sản mới
    </button>
  </div>

  <% if (message) { %>
    <div class="badge <%= message.type === 'success' ? 'badge-completed' : 'badge-cancelled' %>" style="display: block; padding: 10px 16px; margin-bottom: 20px; font-size: 0.9rem;">
      <%= message.text %>
    </div>
  <% } %>

  <!-- Bộ lọc & Tìm kiếm -->
  <div style="display: flex; gap: 14px; margin-bottom: 20px; flex-wrap: wrap;">
    <form action="/admin/products" method="GET" style="display: flex; gap: 10px; flex: 1;">
      <input type="text" name="search" placeholder="Tìm theo tên hoặc xuất xứ..." value="<%= searchQuery %>" class="form-control" style="max-width: 320px;">
      <select name="category" class="form-control" style="max-width: 200px;" onchange="this.form.submit()">
        <option value="">-- Tất cả danh mục --</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat.id %>" <%= selectedCategory == cat.id ? 'selected' : '' %>><%= cat.name %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn-sm btn-primary-sm">Tìm kiếm</button>
    </form>
  </div>

  <!-- Bảng sản phẩm -->
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Hình ảnh</th>
          <th>Tên nông sản</th>
          <th>Danh mục</th>
          <th>Giá bán</th>
          <th>Tồn kho</th>
          <th>Xuất xứ</th>
          <th>Đặc điểm</th>
          <th style="text-align: right;">Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% if (products.length === 0) { %>
          <tr>
            <td colspan="9" style="text-align: center; color: var(--admin-muted); padding: 30px;">Không có sản phẩm nào phù hợp.</td>
          </tr>
        <% } else { %>
          <% products.forEach(p => { %>
            <tr>
              <td>#<%= p.id %></td>
              <td>
                <img src="<%= p.image %>" alt="<%= p.name %>" style="width: 48px; height: 48px; object-fit: cover; border-radius: 6px;">
              </td>
              <td>
                <strong style="font-size: 0.95rem;"><%= p.name %></strong>
                <div style="font-size: 0.78rem; color: var(--admin-muted);"><%= p.certification %></div>
              </td>
              <td><%= p.category_name %></td>
              <td>
                <strong style="color: var(--admin-primary);"><%= Number(p.price).toLocaleString('vi-VN') %>đ</strong>
                <span style="font-size: 0.8rem; color: var(--admin-muted);">/<%= p.unit %></span>
              </td>
              <td>
                <span style="font-weight: 700; <%= p.stock <= 10 ? 'color: red;' : '' %>"><%= p.stock %></span>
              </td>
              <td><%= p.origin %></td>
              <td>
                <% if (p.is_featured) { %><span class="badge" style="background:#fff3e0; color:#e65100;">Bán chạy</span><% } %>
                <% if (p.is_new) { %><span class="badge" style="background:#e8f5e9; color:#2e7d32;">Mới về</span><% } %>
              </td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 6px;">
                  <a href="/products/<%= p.id %>/qrcode?download=1" class="btn-sm btn-outline-sm" title="Tải tem QR cho bao bì">
                    <i class="fa-solid fa-qrcode"></i> Tem QR
                  </a>
                  <button class="btn-sm btn-outline-sm btn-open-edit-product" data-product='<%- JSON.stringify(p).replace(/'/g, "&apos;") %>'>
                    <i class="fa-regular fa-pen-to-square"></i> Sửa
                  </button>
                  <form action="/admin/products/delete/<%= p.id %>" method="POST" style="display: inline; margin: 0;">
                    <button type="submit" class="btn-sm btn-danger-sm btn-confirm-delete">
                      <i class="fa-regular fa-trash-can"></i> Xóa
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Phân trang -->
  <% if (totalPages > 1) { %>
    <div style="display: flex; justify-content: center; gap: 8px; margin-top: 24px;">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="/admin/products?page=<%= i %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>" 
           class="btn-sm <%= currentPage === i ? 'btn-primary-sm' : 'btn-outline-sm' %>">
          <%= i %>
        </a>
      <% } %>
    </div>
  <% } %>
</div>

<!-- MODAL THÊM SẢN PHẨM -->
<div id="add-product-modal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <h3 class="modal-title"><i class="fa-solid fa-plus-circle"></i> Thêm Nông Sản Mới</h3>
      <button type="button" class="modal-close close-add-modal">&times;</button>
    </div>

    <form action="/admin/products/add" method="POST">
      <div class="form-group">
        <label>Tên nông sản *</label>
        <input type="text" name="name" class="form-control" required placeholder="Ví dụ: Cà chua bi Cherry">
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label>Danh mục *</label>
          <select name="category_id" class="form-control" required>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>"><%= cat.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Chứng nhận an toàn</label>
          <input type="text" name="certification" class="form-control" value="VietGAP" placeholder="VietGAP, Hữu cơ...">
        </div>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label>Giá bán (VNĐ) *</label>
          <input type="number" name="price" class="form-control" required placeholder="50000">
        </div>
        <div class="form-group">
          <label>Giá gốc gạch ngang (nếu giảm giá)</label>
          <input type="number" name="original_price" class="form-control" placeholder="65000">
        </div>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label>Đơn vị tính</label>
          <input type="text" name="unit" class="form-control" value="kg" placeholder="kg, hộp 500g, túi...">
        </div>
        <div class="form-group">
          <label>Số lượng tồn kho</label>
          <input type="number" name="stock" class="form-control" value="100">
        </div>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label>Xuất xứ (Nơi trồng)</label>
          <input type="text" name="origin" class="form-control" value="Đà Lạt, Lâm Đồng">
        </div>
        <div class="form-group">
          <label>Ngày thu hoạch</label>
          <input type="text" name="harvest_date" class="form-control" value="Hái mới mỗi sáng">
        </div>
      </div>

      <div class="form-group">
        <label>Hạn sử dụng</label>
        <input type="text" name="shelf_life" class="form-control" value="5 - 7 ngày bảo quản mát">
      </div>

      <div class="form-group">
        <label>Đường dẫn hình ảnh (URL) *</label>
        <input type="url" name="image" class="form-control" required value="https://images.unsplash.com/photo-1540420773420-3366772f4999?w=800&auto=format&fit=crop&q=80">
      </div>

      <div class="form-group">
        <label>Mô tả ngắn</label>
        <textarea name="short_description" class="form-control" rows="2" placeholder="Tóm tắt điểm đặc sắc nhất của nông sản"></textarea>
      </div>

      <div class="form-group">
        <label>Mô tả chi tiết & Câu chuyện sản phẩm</label>
        <textarea name="description" class="form-control" rows="3" placeholder="Chi tiết canh tác hữu cơ, nguồn gốc giống..."></textarea>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label>Giá trị dinh dưỡng</label>
          <textarea name="nutrition_info" class="form-control" rows="2" placeholder="Hàm lượng vitamin, khoáng chất..."></textarea>
        </div>
        <div class="form-group">
          <label>Cách bảo quản</label>
          <textarea name="storage_guide" class="form-control" rows="2" placeholder="Nhiệt độ thích hợp, bọc màng thực phẩm..."></textarea>
        </div>
      </div>

      <div style="display: flex; gap: 20px; margin-bottom: 20px;">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <input type="checkbox" name="is_featured" value="1" checked> Sản phẩm nổi bật
        </label>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <input type="checkbox" name="is_new" value="1" checked> Nông sản mới về
        </label>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 12px;">
        <button type="button" class="btn-sm btn-outline-sm close-add-modal">Hủy bỏ</button>
        <button type="submit" class="btn-sm btn-primary-sm" style="padding: 10px 20px;">Lưu nông sản</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL SỬA SẢN PHẨM -->
<div id="edit-product-modal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <h3 class="modal-title"><i class="fa-regular fa-pen-to-square"></i> Cập Nhật Nông Sản</h3>
      <button type="button" class="modal-close close-edit-modal">&times;</button>
    </div>

    <form id="edit-product-form" method="POST">
      <div class="form-group">
        <label>Tên nông sản *</label>
        <input type="text" id="edit-name" name="name" class="form-control" required>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label>Danh mục *</label>
          <select id="edit-category" name="category_id" class="form-control" required>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>"><%= cat.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Chứng nhận</label>
          <input type="text" id="edit-certification" name="certification" class="form-control">
        </div>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label>Giá bán (VNĐ) *</label>
          <input type="number" id="edit-price" name="price" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Giá gốc</label>
          <input type="number" id="edit-original-price" name="original_price" class="form-control">
        </div>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label>Đơn vị tính</label>
          <input type="text" id="edit-unit" name="unit" class="form-control">
        </div>
        <div class="form-group">
          <label>Tồn kho</label>
          <input type="number" id="edit-stock" name="stock" class="form-control">
        </div>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label>Xuất xứ</label>
          <input type="text" id="edit-origin" name="origin" class="form-control">
        </div>
        <div class="form-group">
          <label>Ngày thu hoạch</label>
          <input type="text" id="edit-harvest-date" name="harvest_date" class="form-control">
        </div>
      </div>

      <div class="form-group">
        <label>Hạn sử dụng</label>
        <input type="text" id="edit-shelf-life" name="shelf_life" class="form-control">
      </div>

      <div class="form-group">
        <label>Đường dẫn hình ảnh (URL)</label>
        <input type="url" id="edit-image" name="image" class="form-control" required>
      </div>

      <div class="form-group">
        <label>Mô tả ngắn</label>
        <textarea id="edit-short-desc" name="short_description" class="form-control" rows="2"></textarea>
      </div>

      <div class="form-group">
        <label>Mô tả chi tiết</label>
        <textarea id="edit-desc" name="description" class="form-control" rows="3"></textarea>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label>Dinh dưỡng</label>
          <textarea id="edit-nutrition" name="nutrition_info" class="form-control" rows="2"></textarea>
        </div>
        <div class="form-group">
          <label>Bảo quản</label>
          <textarea id="edit-storage" name="storage_guide" class="form-control" rows="2"></textarea>
        </div>
      </div>

      <div style="display: flex; gap: 20px; margin-bottom: 20px;">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <input type="checkbox" id="edit-featured" name="is_featured" value="1"> Nổi bật
        </label>
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <input type="checkbox" id="edit-new" name="is_new" value="1"> Mới về
        </label>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 12px;">
        <button type="button" class="btn-sm btn-outline-sm close-edit-modal">Đóng</button>
        <button type="submit" class="btn-sm btn-primary-sm" style="padding: 10px 20px;">Lưu cập nhật</button>
      </div>
    </form>
  </div>
</div>
