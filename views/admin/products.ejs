<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <h2 class="admin-card-title"><i class="fa-solid fa-boxes-stacked"></i> Danh Sách Nông Sản (<%= totalProducts %>)</h2>
    </div>
    <button id="btn-open-add-product" class="btn-sm btn-primary-sm" style="padding: 10px 18px; font-size: 0.9rem;">
      <i class="fa-solid fa-plus"></i> Thêm nông sản mới
    </button>
  </div>

  <% if (message) { %>
    <div class="badge <%= message.type === 'success' ? 'badge-completed' : 'badge-cancelled' %>" style="display: block; padding: 10px 16px; margin-bottom: 20px; font-size: 0.9rem;">
      <%= message.text %>
    </div>
  <% } %>

  <!-- Bộ lọc & Tìm kiếm -->
  <div style="display: flex; gap: 14px; margin-bottom: 20px; flex-wrap: wrap;">
    <form action="/admin/products" method="GET" style="display: flex; gap: 10px; flex: 1;">
      <input type="text" name="search" placeholder="Tìm theo tên hoặc xuất xứ..." value="<%= searchQuery %>" class="form-control" style="max-width: 320px;">
      <select name="category" class="form-control" style="max-width: 200px;" onchange="this.form.submit()">
        <option value="">-- Tất cả danh mục --</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat.id %>" <%= selectedCategory == cat.id ? 'selected' : '' %>><%= cat.name %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn-sm btn-primary-sm">Tìm kiếm</button>
    </form>
  </div>

  <!-- Bảng sản phẩm -->
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Hình ảnh</th>
          <th>Tên nông sản</th>
          <th>Danh mục</th>
          <th>Giá bán</th>
          <th>Tồn kho</th>
          <th>Xuất xứ</th>
          <th>Đặc điểm</th>
          <th style="text-align: right;">Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% if (products.length === 0) { %>
          <tr>
            <td colspan="9" style="text-align: center; color: var(--admin-muted); padding: 30px;">Không có sản phẩm nào phù hợp.</td>
          </tr>
        <% } else { %>
          <% products.forEach(p => { %>
            <tr>
              <td>#<%= p.id %></td>
              <td>
                <img src="<%= p.image %>" alt="<%= p.name %>" style="width: 48px; height: 48px; object-fit: cover; border-radius: 6px;">
              </td>
              <td>
                <strong style="font-size: 0.95rem;"><%= p.name %></strong>
                <div style="font-size: 0.78rem; color: var(--admin-muted);"><%= p.certification %></div>
              </td>
              <td><%= p.category_name %></td>
              <td>
                <strong style="color: var(--admin-primary);"><%= Number(p.price).toLocaleString('vi-VN') %>đ</strong>
                <span style="font-size: 0.8rem; color: var(--admin-muted);">/<%= p.unit %></span>
              </td>
              <td>
                <span style="font-weight: 700; <%= p.stock <= 10 ? 'color: red;' : '' %>"><%= p.stock %></span>
              </td>
              <td><%= p.origin %></td>
              <td>
                <% if (p.is_featured) { %><span class="badge" style="background:#fff3e0; color:#e65100;">Bán chạy</span><% } %>
                <% if (p.is_new) { %><span class="badge" style="background:#e8f5e9; color:#2e7d32;">Mới về</span><% } %>
              </td>
              <td style="text-align: right;">
                <div style="display: inline-flex; gap: 6px;">
                  <a href="/admin/farming-logs?product_id=<%= p.id %>" class="btn-sm btn-outline-sm" title="Quản lý nhật ký canh tác của sản phẩm này" style="color: #2e7d32; border-color: #a5d6a7;">
                    <i class="fa-solid fa-clipboard-list"></i> Nhật ký
                  </a>
                  <a href="/products/<%= p.id %>/qrcode?download=1" class="btn-sm btn-outline-sm" title="Tải tem QR cho bao bì">
                    <i class="fa-solid fa-qrcode"></i> Tem QR
                  </a>
                  <button class="btn-sm btn-outline-sm btn-open-edit-product" data-product='<%- JSON.stringify(p).replace(/'/g, "&apos;") %>'>
                    <i class="fa-regular fa-pen-to-square"></i> Sửa
                  </button>
                  <form action="/admin/products/delete/<%= p.id %>" method="POST" style="display: inline; margin: 0;">
                    <button type="submit" class="btn-sm btn-danger-sm btn-confirm-delete">
                      <i class="fa-regular fa-trash-can"></i> Xóa
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Phân trang -->
  <% if (totalPages > 1) { %>
    <div style="display: flex; justify-content: center; gap: 8px; margin-top: 24px;">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="/admin/products?page=<%= i %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>" 
           class="btn-sm <%= currentPage === i ? 'btn-primary-sm' : 'btn-outline-sm' %>">
          <%= i %>
        </a>
      <% } %>
    </div>
  <% } %>
</div>

<!-- MODAL THÊM SẢN PHẨM -->
<!-- MODAL THÊM SẢN PHẨM -->
<div id="add-product-modal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <div>
        <h3 class="modal-title">
          <span class="modal-title-icon"><i class="fa-solid fa-leaf"></i></span>
          <span>Thêm Nông Sản Mới</span>
        </h3>
        <div class="modal-subtitle">Tạo mới hồ sơ nông sản sạch, thiết lập giá bán và tiêu chuẩn VietGAP</div>
      </div>
      <button type="button" class="modal-close close-add-modal" title="Đóng">&times;</button>
    </div>

    <!-- Tabs chuyển đổi -->
    <div class="admin-modal-tabs">
      <button type="button" class="modal-tab-btn active" data-target="add-tab-basic">
        <i class="fa-solid fa-circle-info"></i> Thông tin & Giá bán
      </button>
      <button type="button" class="modal-tab-btn" data-target="add-tab-image">
        <i class="fa-solid fa-image"></i> Hình ảnh nông sản
      </button>
      <button type="button" class="modal-tab-btn" data-target="add-tab-vietgap">
        <i class="fa-solid fa-award"></i> Tiêu chuẩn & Nguồn gốc
      </button>
      <button type="button" class="modal-tab-btn" data-target="add-tab-desc">
        <i class="fa-solid fa-file-lines"></i> Mô tả & Bảo quản
      </button>
    </div>

    <form action="/admin/products/add" method="POST" enctype="multipart/form-data" id="add-product-form">
      <!-- TAB 1: THÔNG TIN & GIÁ -->
      <div id="add-tab-basic" class="modal-tab-pane active">
        <div class="form-group">
          <label>Tên nông sản / Sản phẩm <span class="required-star">*</span></label>
          <input type="text" name="name" class="form-control" required placeholder="Ví dụ: Rau muống lá tre VietGAP, Cà chua Cherry Sakata...">
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label>Danh mục sản phẩm <span class="required-star">*</span></label>
            <select name="category_id" class="form-control" required>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Đơn vị tính</label>
            <div class="input-with-affix">
              <input type="text" name="unit" class="form-control" value="kg" placeholder="kg, bó 500g, khay 1kg, hộp...">
              <span class="input-affix">ĐVT</span>
            </div>
          </div>
        </div>

        <div class="grid-3">
          <div class="form-group">
            <label>Giá bán hiện tại <span class="required-star">*</span></label>
            <div class="input-with-affix">
              <input type="number" id="add-price" name="price" class="form-control" required placeholder="35000" min="0" step="1000">
              <span class="input-affix">VNĐ</span>
            </div>
            <div id="add-price-preview" class="price-preview-tag" style="display: none;">
              <i class="fa-solid fa-tag"></i> <span>0 đ</span>
            </div>
          </div>
          <div class="form-group">
            <label>Giá niêm yết (Gạch ngang)</label>
            <div class="input-with-affix">
              <input type="number" id="add-original-price" name="original_price" class="form-control" placeholder="45000" min="0" step="1000">
              <span class="input-affix">VNĐ</span>
            </div>
            <div id="add-orig-price-preview" class="price-preview-tag" style="display: none; background: #fff3e0; color: #e65100; border-color: #ffe0b2;">
              <i class="fa-solid fa-tag"></i> <span>0 đ</span>
            </div>
          </div>
          <div class="form-group">
            <label>Số lượng tồn kho</label>
            <input type="number" name="stock" class="form-control" value="100" min="0">
          </div>
        </div>

        <!-- Thẻ bật tắt nổi bật & nông sản mới dạng Switch Card -->
        <div class="feature-toggle-grid">
          <div class="feature-toggle-card featured-card active" id="card-add-featured">
            <div class="feature-toggle-icon icon-featured">
              <i class="fa-solid fa-fire"></i>
            </div>
            <div class="feature-toggle-info">
              <span class="feature-toggle-title">Sản phẩm nổi bật / Bán chạy</span>
              <span class="feature-toggle-desc">Ưu tiên hiển thị đầu trang chủ & mục đề xuất</span>
            </div>
            <input type="checkbox" id="add-featured" name="is_featured" value="1" checked>
          </div>

          <div class="feature-toggle-card active" id="card-add-new">
            <div class="feature-toggle-icon icon-new">
              <i class="fa-solid fa-sparkles"></i>
            </div>
            <div class="feature-toggle-info">
              <span class="feature-toggle-title">Nông sản mới thu hoạch</span>
              <span class="feature-toggle-desc">Gắn nhãn "Mới" xanh tươi thu hút khách</span>
            </div>
            <input type="checkbox" id="add-new" name="is_new" value="1" checked>
          </div>
        </div>
      </div>

      <!-- TAB 2: HÌNH ẢNH SẢN PHẨM -->
      <div id="add-tab-image" class="modal-tab-pane">
        <div class="product-image-grid">
          <!-- Cột trái: Xem trước ảnh trực tiếp -->
          <div class="image-preview-wrapper">
            <div class="image-preview-box">
              <img id="add-preview-img" src="https://images.unsplash.com/photo-1540420773420-3366772f4999?w=800&auto=format&fit=crop&q=80" alt="Xem trước ảnh nông sản">
              <div class="preview-tag"><i class="fa-solid fa-eye"></i> Xem trước trực tiếp</div>
            </div>
            <div style="font-size: 0.8rem; color: var(--admin-muted); margin-top: 8px;">
              Tỷ lệ khuyến nghị: 1:1 hoặc 4:3 (Tối thiểu 600x600px)
            </div>
          </div>

          <!-- Cột phải: Tải file & nhập URL & ảnh mẫu -->
          <div>
            <!-- Khu vực tải file từ máy tính -->
            <input type="file" id="add-image-file" name="product_image_file" accept="image/*" style="display: none;">
            <div class="dropzone-card" id="add-dropzone-trigger">
              <div class="dropzone-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
              <div class="dropzone-text" id="add-file-status">Bấm để tải ảnh từ máy tính lên</div>
              <div class="dropzone-subtext">Hỗ trợ JPG, PNG, WEBP (Tối đa 10MB)</div>
            </div>

            <!-- Hoặc nhập link ảnh trực tiếp -->
            <div class="form-group" style="margin-bottom: 16px;">
              <label>Đường dẫn hình ảnh (URL):</label>
              <div style="display: flex; gap: 8px;">
                <input type="url" id="add-image-url" name="image" class="form-control" value="https://images.unsplash.com/photo-1540420773420-3366772f4999?w=800&auto=format&fit=crop&q=80" placeholder="https://domain.com/hinh-anh.jpg">
                <button type="button" class="btn-sm btn-outline-sm" id="btn-add-preview-url" style="white-space: nowrap; padding: 10px 16px;">
                  <i class="fa-solid fa-rotate"></i> Xem thử
                </button>
              </div>
            </div>

            <!-- Gợi ý ảnh mẫu đẹp một chạm -->
            <div class="preset-section-title"><i class="fa-solid fa-wand-magic-sparkles" style="color: #2e7d32;"></i> Gợi ý ảnh nông sản sạch một chạm:</div>
            <div class="preset-gallery" data-target-modal="add">
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1540420773420-3366772f4999?w=800&auto=format&fit=crop&q=80" title="Rau muống xanh">
                <img src="https://images.unsplash.com/photo-1540420773420-3366772f4999?w=200&auto=format&fit=crop&q=80" alt="Rau muống">
                <span>Rau muống</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1592924357228-91a4daadcfea?w=800&auto=format&fit=crop&q=80" title="Cà chua Cherry">
                <img src="https://images.unsplash.com/photo-1592924357228-91a4daadcfea?w=200&auto=format&fit=crop&q=80" alt="Cà chua">
                <span>Cà chua</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1449300079323-02e209d9d3a6?w=800&auto=format&fit=crop&q=80" title="Dưa leo baby">
                <img src="https://images.unsplash.com/photo-1449300079323-02e209d9d3a6?w=200&auto=format&fit=crop&q=80" alt="Dưa leo">
                <span>Dưa leo</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1598170845058-32b9d6a5da37?w=800&auto=format&fit=crop&q=80" title="Cà rốt hữu cơ">
                <img src="https://images.unsplash.com/photo-1598170845058-32b9d6a5da37?w=200&auto=format&fit=crop&q=80" alt="Cà rốt">
                <span>Cà rốt</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1518977676601-b53f82aba655?w=800&auto=format&fit=crop&q=80" title="Khoai tây">
                <img src="https://images.unsplash.com/photo-1518977676601-b53f82aba655?w=200&auto=format&fit=crop&q=80" alt="Khoai tây">
                <span>Khoai tây</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1464965911861-746a04b4bca6?w=800&auto=format&fit=crop&q=80" title="Dâu tây Đà Lạt">
                <img src="https://images.unsplash.com/photo-1464965911861-746a04b4bca6?w=200&auto=format&fit=crop&q=80" alt="Dâu tây">
                <span>Dâu tây</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1509358271058-acd22cc93898?w=800&auto=format&fit=crop&q=80" title="Nấm sạch">
                <img src="https://images.unsplash.com/photo-1509358271058-acd22cc93898?w=200&auto=format&fit=crop&q=80" alt="Nấm">
                <span>Nấm sạch</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1611080626919-7cf5a9dbab5b?w=800&auto=format&fit=crop&q=80" title="Cam sành">
                <img src="https://images.unsplash.com/photo-1611080626919-7cf5a9dbab5b?w=200&auto=format&fit=crop&q=80" alt="Cam sành">
                <span>Cam sành</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: TIÊU CHUẨN & NGUỒN GỐC -->
      <div id="add-tab-vietgap" class="modal-tab-pane">
        <div class="form-section-banner">
          <i class="fa-solid fa-shield-halved"></i>
          <div>
            <div class="form-section-banner-title">Tiêu Chuẩn Nông Nghiệp & Nguồn Gốc Xuất Xứ</div>
            <div class="form-section-banner-desc">Minh bạch thông tin vùng trồng và tiêu chuẩn chất lượng VietGAP/GlobalGAP</div>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label><i class="fa-solid fa-location-dot" style="color: #2e7d32;"></i> Xuất xứ (Vùng trồng canh tác)</label>
            <input type="text" name="origin" class="form-control" value="Bình Mỹ, Củ Chi" placeholder="Ví dụ: Bình Mỹ, Củ Chi">
          </div>
          <div class="form-group">
            <label><i class="fa-solid fa-certificate" style="color: #2e7d32;"></i> Chứng nhận an toàn</label>
            <input type="text" name="certification" class="form-control" value="VietGAP" placeholder="VietGAP, GlobalGAP, Hữu cơ Organic, OCOP 4 sao...">
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label><i class="fa-solid fa-calendar-check" style="color: #2e7d32;"></i> Thời điểm / Chu kỳ thu hoạch</label>
            <input type="text" name="harvest_date" class="form-control" value="Hái tươi mỗi sáng sớm" placeholder="Ví dụ: Hái mới mỗi sáng, Thu hoạch ngày 27/09/2026...">
          </div>
          <div class="form-group">
            <label><i class="fa-solid fa-clock" style="color: #2e7d32;"></i> Hạn sử dụng khuyến nghị</label>
            <input type="text" name="shelf_life" class="form-control" value="5 - 7 ngày bảo quản ngăn mát" placeholder="5-7 ngày, 1 tháng...">
          </div>
        </div>
      </div>

      <!-- TAB 4: MÔ TẢ & BẢO QUẢN -->
      <div id="add-tab-desc" class="modal-tab-pane">
        <div class="form-group">
          <label><i class="fa-solid fa-align-left" style="color: #2e7d32;"></i> Mô tả ngắn (Hiển thị ở danh sách sản phẩm)</label>
          <textarea name="short_description" class="form-control" rows="2" placeholder="Tóm tắt ngắn gọn hương vị, độ tươi và ưu điểm nổi bật nhất..."></textarea>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-newspaper" style="color: #2e7d32;"></i> Mô tả chi tiết & Câu chuyện sản phẩm</label>
          <textarea name="description" class="form-control" rows="3" placeholder="Quy trình chăm sóc, nguồn nước giếng lắng lọc, giống hạt F1, không thuốc trừ sâu hóa học..."></textarea>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label><i class="fa-solid fa-apple-whole" style="color: #2e7d32;"></i> Giá trị dinh dưỡng</label>
            <textarea name="nutrition_info" class="form-control" rows="2" placeholder="Chứa nhiều vitamin C, chất xơ, sắt, khoáng chất vi lượng..."></textarea>
          </div>
          <div class="form-group">
            <label><i class="fa-solid fa-box-archive" style="color: #2e7d32;"></i> Hướng dẫn bảo quản & Sử dụng</label>
            <textarea name="storage_guide" class="form-control" rows="2" placeholder="Rửa sạch trước khi chế biến, bảo quản trong túi giấy hoặc màng bọc thực phẩm nhiệt độ 4-8°C..."></textarea>
          </div>
        </div>
      </div>

      <!-- Footer Buttons -->
      <div class="modal-footer-actions">
        <button type="button" class="btn-modal-cancel close-add-modal">
          <i class="fa-solid fa-xmark"></i> Hủy bỏ
        </button>
        <button type="submit" class="btn-modal-submit">
          <i class="fa-solid fa-floppy-disk"></i> Lưu nông sản mới
        </button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL SỬA SẢN PHẨM -->
<div id="edit-product-modal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <div>
        <h3 class="modal-title">
          <span class="modal-title-icon"><i class="fa-regular fa-pen-to-square"></i></span>
          <span>Cập Nhật Thông Tin Nông Sản</span>
          <span id="edit-badge-id" class="modal-badge-id">#ID</span>
        </h3>
        <div class="modal-subtitle">Chỉnh sửa thông tin giá bán, hình ảnh và hồ sơ nguồn gốc nông sản</div>
      </div>
      <button type="button" class="modal-close close-edit-modal" title="Đóng">&times;</button>
    </div>

    <!-- Tabs chuyển đổi cho Sửa -->
    <div class="admin-modal-tabs">
      <button type="button" class="modal-tab-btn active" data-target="edit-tab-basic">
        <i class="fa-solid fa-circle-info"></i> Thông tin & Giá bán
      </button>
      <button type="button" class="modal-tab-btn" data-target="edit-tab-image">
        <i class="fa-solid fa-image"></i> Hình ảnh nông sản
      </button>
      <button type="button" class="modal-tab-btn" data-target="edit-tab-vietgap">
        <i class="fa-solid fa-award"></i> Tiêu chuẩn & Nguồn gốc
      </button>
      <button type="button" class="modal-tab-btn" data-target="edit-tab-desc">
        <i class="fa-solid fa-file-lines"></i> Mô tả & Bảo quản
      </button>
    </div>

    <form id="edit-product-form" method="POST" enctype="multipart/form-data">
      <!-- TAB 1: THÔNG TIN & GIÁ -->
      <div id="edit-tab-basic" class="modal-tab-pane active">
        <div class="form-group">
          <label>Tên nông sản / Sản phẩm <span class="required-star">*</span></label>
          <input type="text" id="edit-name" name="name" class="form-control" required placeholder="Nhập tên nông sản sạch...">
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label>Danh mục sản phẩm <span class="required-star">*</span></label>
            <select id="edit-category" name="category_id" class="form-control" required>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Đơn vị tính</label>
            <div class="input-with-affix">
              <input type="text" id="edit-unit" name="unit" class="form-control" placeholder="kg, bó 500g, khay 1kg, hộp...">
              <span class="input-affix">ĐVT</span>
            </div>
          </div>
        </div>

        <div class="grid-3">
          <div class="form-group">
            <label>Giá bán hiện tại <span class="required-star">*</span></label>
            <div class="input-with-affix">
              <input type="number" id="edit-price" name="price" class="form-control" required placeholder="0" min="0" step="1000">
              <span class="input-affix">VNĐ</span>
            </div>
            <div id="edit-price-preview" class="price-preview-tag" style="display: none;">
              <i class="fa-solid fa-tag"></i> <span>0 đ</span>
            </div>
          </div>
          <div class="form-group">
            <label>Giá niêm yết (Gạch ngang)</label>
            <div class="input-with-affix">
              <input type="number" id="edit-original-price" name="original_price" class="form-control" placeholder="0" min="0" step="1000">
              <span class="input-affix">VNĐ</span>
            </div>
            <div id="edit-orig-price-preview" class="price-preview-tag" style="display: none; background: #fff3e0; color: #e65100; border-color: #ffe0b2;">
              <i class="fa-solid fa-tag"></i> <span>0 đ</span>
            </div>
          </div>
          <div class="form-group">
            <label>Số lượng tồn kho</label>
            <input type="number" id="edit-stock" name="stock" class="form-control" placeholder="0" min="0">
          </div>
        </div>

        <!-- Thẻ bật tắt nổi bật & nông sản mới dạng Switch Card -->
        <div class="feature-toggle-grid">
          <div class="feature-toggle-card featured-card" id="card-edit-featured">
            <div class="feature-toggle-icon icon-featured">
              <i class="fa-solid fa-fire"></i>
            </div>
            <div class="feature-toggle-info">
              <span class="feature-toggle-title">Sản phẩm nổi bật / Bán chạy</span>
              <span class="feature-toggle-desc">Ưu tiên hiển thị đầu trang chủ & mục đề xuất</span>
            </div>
            <input type="checkbox" id="edit-featured" name="is_featured" value="1">
          </div>

          <div class="feature-toggle-card" id="card-edit-new">
            <div class="feature-toggle-icon icon-new">
              <i class="fa-solid fa-sparkles"></i>
            </div>
            <div class="feature-toggle-info">
              <span class="feature-toggle-title">Nông sản mới thu hoạch</span>
              <span class="feature-toggle-desc">Gắn nhãn "Mới" xanh tươi thu hút khách</span>
            </div>
            <input type="checkbox" id="edit-new" name="is_new" value="1">
          </div>
        </div>
      </div>

      <!-- TAB 2: HÌNH ẢNH SẢN PHẨM -->
      <div id="edit-tab-image" class="modal-tab-pane">
        <div class="product-image-grid">
          <!-- Cột trái: Xem trước ảnh trực tiếp -->
          <div class="image-preview-wrapper">
            <div class="image-preview-box">
              <img id="edit-preview-img" src="" alt="Hình ảnh sản phẩm">
              <div class="preview-tag"><i class="fa-solid fa-camera"></i> Ảnh hiển thị hiện tại</div>
            </div>
            <div style="font-size: 0.8rem; color: var(--admin-muted); margin-top: 8px;">
              Xem trước tức thì khi chọn file hoặc đổi link
            </div>
          </div>

          <!-- Cột phải: Đổi ảnh từ máy tính hoặc đổi link URL -->
          <div>
            <!-- Khu vực tải file ảnh mới -->
            <input type="file" id="edit-image-file" name="product_image_file" accept="image/*" style="display: none;">
            <div class="dropzone-card" id="edit-dropzone-trigger">
              <div class="dropzone-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
              <div class="dropzone-text" id="edit-file-status">Bấm để thay ảnh mới từ máy tính</div>
              <div class="dropzone-subtext">Hỗ trợ JPG, PNG, WEBP (Tự động tải & cập nhật)</div>
            </div>

            <!-- Đường dẫn ảnh hiện tại / nhập URL mới -->
            <div class="form-group" style="margin-bottom: 16px;">
              <label>Đường dẫn hình ảnh (URL):</label>
              <div style="display: flex; gap: 8px;">
                <input type="text" id="edit-image" name="image" class="form-control" placeholder="https://... hoặc /uploads/products/...">
                <button type="button" class="btn-sm btn-outline-sm" id="btn-edit-preview-url" style="white-space: nowrap; padding: 10px 16px;">
                  <i class="fa-solid fa-rotate"></i> Xem thử
                </button>
              </div>
            </div>

            <!-- Gợi ý ảnh mẫu đẹp một chạm -->
            <div class="preset-section-title"><i class="fa-solid fa-wand-magic-sparkles" style="color: #2e7d32;"></i> Hoặc chọn nhanh ảnh mẫu có sẵn:</div>
            <div class="preset-gallery" data-target-modal="edit">
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1540420773420-3366772f4999?w=800&auto=format&fit=crop&q=80" title="Rau muống xanh">
                <img src="https://images.unsplash.com/photo-1540420773420-3366772f4999?w=200&auto=format&fit=crop&q=80" alt="Rau muống">
                <span>Rau muống</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1592924357228-91a4daadcfea?w=800&auto=format&fit=crop&q=80" title="Cà chua Cherry">
                <img src="https://images.unsplash.com/photo-1592924357228-91a4daadcfea?w=200&auto=format&fit=crop&q=80" alt="Cà chua">
                <span>Cà chua</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1449300079323-02e209d9d3a6?w=800&auto=format&fit=crop&q=80" title="Dưa leo baby">
                <img src="https://images.unsplash.com/photo-1449300079323-02e209d9d3a6?w=200&auto=format&fit=crop&q=80" alt="Dưa leo">
                <span>Dưa leo</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1598170845058-32b9d6a5da37?w=800&auto=format&fit=crop&q=80" title="Cà rốt hữu cơ">
                <img src="https://images.unsplash.com/photo-1598170845058-32b9d6a5da37?w=200&auto=format&fit=crop&q=80" alt="Cà rốt">
                <span>Cà rốt</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1518977676601-b53f82aba655?w=800&auto=format&fit=crop&q=80" title="Khoai tây">
                <img src="https://images.unsplash.com/photo-1518977676601-b53f82aba655?w=200&auto=format&fit=crop&q=80" alt="Khoai tây">
                <span>Khoai tây</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1464965911861-746a04b4bca6?w=800&auto=format&fit=crop&q=80" title="Dâu tây Đà Lạt">
                <img src="https://images.unsplash.com/photo-1464965911861-746a04b4bca6?w=200&auto=format&fit=crop&q=80" alt="Dâu tây">
                <span>Dâu tây</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1509358271058-acd22cc93898?w=800&auto=format&fit=crop&q=80" title="Nấm sạch">
                <img src="https://images.unsplash.com/photo-1509358271058-acd22cc93898?w=200&auto=format&fit=crop&q=80" alt="Nấm">
                <span>Nấm sạch</span>
              </div>
              <div class="preset-thumb-item" data-url="https://images.unsplash.com/photo-1611080626919-7cf5a9dbab5b?w=800&auto=format&fit=crop&q=80" title="Cam sành">
                <img src="https://images.unsplash.com/photo-1611080626919-7cf5a9dbab5b?w=200&auto=format&fit=crop&q=80" alt="Cam sành">
                <span>Cam sành</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: TIÊU CHUẨN & NGUỒN GỐC -->
      <div id="edit-tab-vietgap" class="modal-tab-pane">
        <div class="form-section-banner">
          <i class="fa-solid fa-shield-halved"></i>
          <div>
            <div class="form-section-banner-title">Tiêu Chuẩn Nông Nghiệp & Nguồn Gốc Xuất Xứ</div>
            <div class="form-section-banner-desc">Minh bạch thông tin vùng trồng và tiêu chuẩn chất lượng VietGAP/GlobalGAP</div>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label><i class="fa-solid fa-location-dot" style="color: #2e7d32;"></i> Xuất xứ (Vùng trồng canh tác)</label>
            <input type="text" id="edit-origin" name="origin" class="form-control" placeholder="Ví dụ: Bình Mỹ, Củ Chi">
          </div>
          <div class="form-group">
            <label><i class="fa-solid fa-certificate" style="color: #2e7d32;"></i> Chứng nhận an toàn</label>
            <input type="text" id="edit-certification" name="certification" class="form-control" placeholder="Ví dụ: VietGAP, GlobalGAP, Hữu cơ Organic...">
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label><i class="fa-solid fa-calendar-check" style="color: #2e7d32;"></i> Thời điểm / Chu kỳ thu hoạch</label>
            <input type="text" id="edit-harvest-date" name="harvest_date" class="form-control" placeholder="Ví dụ: Thu hái sáng sớm mỗi ngày">
          </div>
          <div class="form-group">
            <label><i class="fa-solid fa-clock" style="color: #2e7d32;"></i> Hạn sử dụng khuyến nghị</label>
            <input type="text" id="edit-shelf-life" name="shelf_life" class="form-control" placeholder="Ví dụ: 3 - 5 ngày (ngăn mát 4 - 8°C)">
          </div>
        </div>
      </div>

      <!-- TAB 4: MÔ TẢ & BẢO QUẢN -->
      <div id="edit-tab-desc" class="modal-tab-pane">
        <div class="form-group">
          <label><i class="fa-solid fa-align-left" style="color: #2e7d32;"></i> Mô tả ngắn (Hiển thị ở danh sách sản phẩm)</label>
          <textarea id="edit-short-desc" name="short_description" class="form-control" rows="2" placeholder="Tóm tắt ngắn gọn 1-2 câu về vị, độ tươi và nguồn gốc..."></textarea>
        </div>

        <div class="form-group">
          <label><i class="fa-solid fa-newspaper" style="color: #2e7d32;"></i> Mô tả chi tiết & Câu chuyện sản phẩm</label>
          <textarea id="edit-desc" name="description" class="form-control" rows="3" placeholder="Giới thiệu quy trình trồng, giống cây, cảm nhận hương vị..."></textarea>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label><i class="fa-solid fa-apple-whole" style="color: #2e7d32;"></i> Giá trị dinh dưỡng</label>
            <textarea id="edit-nutrition" name="nutrition_info" class="form-control" rows="2" placeholder="Chứa vitamin C, chất xơ, khoáng chất vi lượng..."></textarea>
          </div>
          <div class="form-group">
            <label><i class="fa-solid fa-box-archive" style="color: #2e7d32;"></i> Hướng dẫn bảo quản</label>
            <textarea id="edit-storage" name="storage_guide" class="form-control" rows="2" placeholder="Rửa sạch trước khi dùng, bọc kín bảo quản ngăn mát..."></textarea>
          </div>
        </div>
      </div>

      <!-- Footer Buttons -->
      <div class="modal-footer-actions">
        <button type="button" class="btn-modal-cancel close-edit-modal">
          <i class="fa-solid fa-xmark"></i> Hủy bỏ
        </button>
        <button type="submit" class="btn-modal-submit">
          <i class="fa-solid fa-check"></i> Lưu cập nhật nông sản
        </button>
      </div>
    </form>
  </div>
</div>
