<div class="container" style="padding-top: 40px; padding-bottom: 60px;">
  <div style="max-width: 720px; margin: 0 auto; background: white; border-radius: var(--radius-lg); border: 1px solid var(--border-color); padding: 40px; box-shadow: var(--shadow-md); text-align: center;">
    
    <div style="width: 76px; height: 76px; background: var(--primary-light); color: var(--primary); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 2.5rem; margin-bottom: 20px;">
      <i class="fa-solid fa-circle-check"></i>
    </div>

    <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--primary); margin-bottom: 8px;">
      Đặt Hàng Thành Công!
    </h1>
    <p style="color: var(--text-muted); font-size: 0.98rem; margin-bottom: 24px;">
      Cảm ơn quý khách đã tin dùng nông sản hữu cơ từ <strong>Bình Mỹ Xanh</strong>.<br>
      Bộ phận giao vận đang chuẩn bị những phần nông sản tươi ngon nhất để gửi đến bạn.
    </p>

    <div style="background: var(--primary-soft); border-radius: var(--radius-md); padding: 20px; text-align: left; margin-bottom: 28px; border: 1px solid var(--primary-border);">
      <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--primary-border); padding-bottom: 10px; margin-bottom: 12px;">
        <span style="color: var(--text-muted);">Mã đơn hàng:</span>
        <strong style="color: var(--primary); font-size: 1.1rem;"><%= order.order_code %></strong>
      </div>
      <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.92rem;">
        <span style="color: var(--text-muted);">Người nhận:</span>
        <strong><%= order.customer_name %> (<%= order.customer_phone %>)</strong>
      </div>
      <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.92rem;">
        <span style="color: var(--text-muted);">Địa chỉ giao:</span>
        <strong style="text-align: right; max-width: 400px;"><%= order.shipping_address %></strong>
      </div>
      <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.92rem;">
        <span style="color: var(--text-muted);">Phương thức:</span>
        <strong><%= order.payment_method === 'banking' ? 'Chuyển khoản VietQR' : 'Thanh toán COD khi nhận hàng' %></strong>
      </div>
      <div style="display: flex; justify-content: space-between; font-size: 1.1rem; border-top: 1px dashed var(--primary-border); padding-top: 10px; margin-top: 10px;">
        <span style="font-weight: 700;">Tổng thanh toán:</span>
        <strong style="color: var(--primary);"><%= Number(order.total_amount).toLocaleString('vi-VN') %>đ</strong>
      </div>
    </div>

    <!-- Nếu chọn thanh toán chuyển khoản thì hiển thị mã VietQR tiện lợi -->
    <% if (order.payment_method === 'banking') { %>
      <div style="background: #ffffff; border: 2px dashed var(--primary); border-radius: var(--radius-md); padding: 24px; margin-bottom: 28px;">
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--primary); margin-bottom: 10px;">
          <i class="fa-solid fa-qrcode"></i> Quét Mã VietQR Để Thanh Toán Nhanh
        </h3>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 16px;">
          Mở ứng dụng Ngân hàng bất kỳ (Vietcombank, MB, Techcombank, BIDV, MoMo...) và quét mã bên dưới:
        </p>
        <img src="https://img.vietqr.io/image/MB-090123456789-compact.png?amount=<%= Math.round(order.total_amount) %>&addInfo=<%= order.order_code %>&accountName=NONG%20SAN%20XANH" 
             alt="VietQR <%= order.order_code %>" 
             style="width: 220px; height: auto; margin: 0 auto; border-radius: 8px; box-shadow: var(--shadow-sm); border: 1px solid #e0e0e0;">
        <div style="margin-top: 14px; font-size: 0.85rem; color: var(--text-muted);">
          Nội dung chuyển khoản: <strong style="color: var(--primary);"><%= order.order_code %></strong>
        </div>
      </div>
    <% } %>

    <div style="display: flex; justify-content: center; gap: 14px;">
      <a href="/" class="btn-primary" style="padding: 12px 28px;">
        <i class="fa-solid fa-house"></i> Về trang chủ
      </a>
      <a href="/products" class="btn-secondary" style="padding: 12px 24px;">
        <i class="fa-solid fa-store"></i> Tiếp tục mua sắm
      </a>
    </div>
  </div>
</div>
