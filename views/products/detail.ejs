<div class="container" style="padding-top: 20px; padding-bottom: 50px;">
  <!-- Breadcrumb -->
  <div class="breadcrumb">
    <a href="/"><i class="fa-solid fa-house"></i> Trang chủ</a>
    <span>/</span>
    <a href="/products">Sản phẩm</a>
    <span>/</span>
    <a href="/products?category=<%= product.category_id %>"><%= product.category_name %></a>
    <span>/</span>
    <span style="color: var(--primary); font-weight: 600;"><%= product.name %></span>
  </div>

  <!-- Chi Tiết Sản Phẩm (Thiết kế phong cách trang bán sách & sàn TMĐT cao cấp) -->
  <div class="product-detail-wrapper">
    <!-- Hình ảnh sản phẩm -->
    <div class="detail-gallery">
      <div style="position: relative; overflow: hidden; border-radius: var(--radius-md);">
        <img src="<%= product.image %>" alt="<%= product.name %>" class="detail-main-img">
        <div style="position: absolute; top: 16px; left: 16px; display: flex; flex-direction: column; gap: 8px;">
          <span class="badge-cert" style="font-size: 0.82rem; padding: 4px 12px; box-shadow: var(--shadow-sm);"><i class="fa-solid fa-certificate"></i> <%= product.certification %></span>
          <% if (product.is_new) { %>
            <span class="badge-new" style="font-size: 0.82rem; padding: 4px 12px;"><i class="fa-solid fa-sparkles"></i> Mới về</span>
          <% } %>
        </div>
      </div>
      <div style="display: flex; gap: 12px; justify-content: center;">
        <img src="<%= product.image %>" alt="Thumbnail" style="width: 70px; height: 70px; object-fit: cover; border-radius: 8px; border: 2px solid var(--primary); cursor: pointer;">
      </div>

      <!-- Tem QR Truy Xuất Nguồn Gốc Chuẩn VietGAP -->
      <div class="qr-traceability-card">
        <div class="qr-traceability-left">
          <img src="/products/<%= product.id %>/qrcode" alt="QR Code <%= product.name %>" class="qr-traceability-img">
        </div>
        <div class="qr-traceability-right">
          <div class="qr-tag"><i class="fa-solid fa-qrcode"></i> Mã QR Nông Sản</div>
          <p class="qr-desc">Dùng điện thoại quét mã QR để mở nhanh trang chi tiết này hoặc in tem dán lên bao bì.</p>
          <div style="display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap;">
            <a href="/products/<%= product.id %>/qrcode?download=1" class="btn-sm btn-outline-sm" title="Tải ảnh QR về máy">
              <i class="fa-solid fa-download"></i> Tải QR
            </a>
            <button type="button" class="btn-sm btn-outline-sm" id="btn-show-qr-modal" title="Phóng to tem QR">
              <i class="fa-solid fa-expand"></i> Tem in
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Thông tin chi tiết sản phẩm -->
    <div class="detail-info">
      <div class="detail-meta-tags">
        <span style="color: var(--text-muted); font-size: 0.88rem;">
          Danh mục: <a href="/products?category=<%= product.category_id %>" style="color: var(--primary); font-weight: 600;"><%= product.category_name %></a>
        </span>
        <span style="color: var(--border-color);">|</span>
        <span style="color: var(--text-muted); font-size: 0.88rem;">
          Mã nông sản: <strong>NS-<%= product.id.toString().padStart(4, '0') %></strong>
        </span>
      </div>

      <h1 class="detail-title"><%= product.name %></h1>

      <div class="product-rating" style="font-size: 0.95rem; margin-bottom: 12px;">
        <span style="color: var(--accent-warm); font-weight: 700; margin-right: 4px;"><%= product.rating %></span>
        <i class="fa-solid fa-star"></i>
        <i class="fa-solid fa-star"></i>
        <i class="fa-solid fa-star"></i>
        <i class="fa-solid fa-star"></i>
        <i class="fa-solid fa-star"></i>
        <span style="color: var(--text-light); margin-left: 8px;">| Đã bán <%= product.sold_count %> <%= product.unit %></span>
        <span style="color: var(--text-light); margin-left: 8px;">| Tồn kho: <strong style="color: var(--primary);"><%= product.stock %></strong> <%= product.unit %></span>
      </div>

      <!-- Bảng thuộc tính quy cách giống sách / sản phẩm công nghệ -->
      <div class="detail-specs-box">
        <div class="spec-item">
          <span class="spec-label"><i class="fa-solid fa-location-dot" style="color: var(--primary);"></i> Xuất xứ:</span>
          <span class="spec-value"><%= product.origin %></span>
        </div>
        <div class="spec-item">
          <span class="spec-label"><i class="fa-solid fa-calendar-check" style="color: var(--primary);"></i> Thu hoạch:</span>
          <span class="spec-value"><%= product.harvest_date %></span>
        </div>
        <div class="spec-item">
          <span class="spec-label"><i class="fa-solid fa-box-archive" style="color: var(--primary);"></i> Quy cách:</span>
          <span class="spec-value"><%= product.unit %></span>
        </div>
        <div class="spec-item">
          <span class="spec-label"><i class="fa-solid fa-clock-rotate-left" style="color: var(--primary);"></i> Hạn dùng:</span>
          <span class="spec-value"><%= product.shelf_life %></span>
        </div>
      </div>

      <!-- Khung giá bán -->
      <div class="detail-price-panel">
        <div class="detail-price"><%= Number(product.price).toLocaleString('vi-VN') %>đ</div>
        <% if (product.original_price && product.original_price > product.price) { %>
          <div class="detail-old-price"><%= Number(product.original_price).toLocaleString('vi-VN') %>đ</div>
          <div class="detail-discount-percent">Tiết kiệm <%= Math.round((1 - product.price / product.original_price) * 100) %>%</div>
        <% } %>
      </div>

      <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 24px;">
        <%= product.short_description %>
      </p>

      <!-- Nút mua hàng & Chọn số lượng -->
      <div class="detail-actions">
        <div class="qty-control">
          <button type="button" class="qty-btn qty-minus">-</button>
          <input type="number" id="qty-<%= product.id %>" class="qty-input detail-qty-input" value="1" min="1" max="<%= product.stock %>">
          <button type="button" class="qty-btn qty-plus">+</button>
        </div>

        <button type="button" class="btn-primary ajax-add-to-cart" data-product-id="<%= product.id %>" style="padding: 12px 28px;">
          <i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ hàng
        </button>

        <form action="/cart/add" method="POST" style="margin: 0;">
          <input type="hidden" name="productId" value="<%= product.id %>">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="btn-buy-now">
            <i class="fa-solid fa-bolt"></i> Mua ngay
          </button>
        </form>
      </div>

      <div style="display: flex; gap: 20px; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--border-color); font-size: 0.88rem; color: var(--text-muted);">
        <div><i class="fa-solid fa-shield-check" style="color: var(--primary);"></i> Nông sản kiểm nghiệm an toàn</div>
        <div><i class="fa-solid fa-truck-fast" style="color: var(--primary);"></i> Giao hàng tươi mới trong ngày</div>
      </div>
    </div>
  </div>

  <!-- Các tab thông tin chi tiết (Giới thiệu, Dinh dưỡng, Bảo quản, Nhận xét) -->
  <section class="detail-tabs-section">
    <div class="tabs-nav">
      <button class="tab-btn active" data-target="tab-desc">Mô tả sản phẩm</button>
      <button class="tab-btn" data-target="tab-nutrition">Giá trị dinh dưỡng</button>
      <button class="tab-btn" data-target="tab-storage">Hướng dẫn bảo quản</button>
      <button class="tab-btn" data-target="tab-reviews">Đánh giá & Nhận xét (5)</button>
    </div>

    <!-- Tab 1: Mô tả -->
    <div id="tab-desc" class="tab-pane active">
      <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 12px; color: var(--primary);">Câu chuyện nông sản & Quy trình gieo trồng</h3>
      <p style="margin-bottom: 16px;"><%= product.description %></p>
      <p>Tất cả sản phẩm tại Bình Mỹ Xanh đều tuân thủ quy trình canh tác nghiêm ngặt, sử dụng nguồn nước tưới tự nhiên sạch, bón phân hữu cơ sinh học ủ mục và kiểm soát sâu bệnh bằng thiên địch, không dùng chất kích thích sinh trưởng.</p>
    </div>

    <!-- Tab 2: Dinh dưỡng -->
    <div id="tab-nutrition" class="tab-pane">
      <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 12px; color: var(--primary);">Hàm lượng dinh dưỡng & Lợi ích sức khỏe</h3>
      <p style="margin-bottom: 16px;"><%= product.nutrition_info %></p>
      <div style="background: var(--primary-soft); border-left: 4px solid var(--primary); padding: 14px 18px; border-radius: 4px;">
        <strong>Lời khuyên chuyên gia dinh dưỡng:</strong> Bổ sung nông sản hữu cơ đều đặn trong thực đơn hàng ngày giúp tăng cường hệ miễn dịch tự nhiên, ngăn ngừa các bệnh mãn tính và làm chậm quá trình lão hóa tế bào.
      </div>
    </div>

    <!-- Tab 3: Bảo quản -->
    <div id="tab-storage" class="tab-pane">
      <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 12px; color: var(--primary);">Cách bảo quản giữ trọn độ tươi ngon</h3>
      <p style="margin-bottom: 16px;"><%= product.storage_guide %></p>
      <ul style="padding-left: 20px; line-height: 1.8;">
        <li>Nên sơ chế hoặc rửa sạch ngay trước khi nấu ăn để tránh làm hỏng lớp sáp tự nhiên bảo vệ quả/rau.</li>
        <li>Bảo quản trong ngăn rau củ tủ lạnh với độ ẩm lý tưởng từ 85 - 90%.</li>
        <li>Tránh để gần các loại trái cây sinh khí ethylene chín nhanh như chuối chín, táo chín.</li>
      </ul>
    </div>

    <!-- Tab 4: Đánh giá -->
    <div id="tab-reviews" class="tab-pane">
      <div style="display: flex; gap: 40px; margin-bottom: 30px; align-items: center;">
        <div style="text-align: center; background: var(--primary-soft); padding: 24px; border-radius: var(--radius-md); min-width: 160px;">
          <div style="font-size: 3rem; font-weight: 800; color: var(--primary); line-height: 1;"><%= product.rating %></div>
          <div style="color: var(--accent-warm); margin: 6px 0;">★★★★★</div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">5 đánh giá từ khách hàng</div>
        </div>
        <div>
          <h4 style="font-weight: 700; margin-bottom: 8px;">Nhận xét từ khách hàng đã mua:</h4>
          <p style="color: var(--text-muted); font-size: 0.9rem;">100% khách hàng hài lòng về độ tươi ngon và quy cách đóng gói an toàn của sản phẩm này.</p>
        </div>
      </div>

      <!-- Sample reviews -->
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div style="border-bottom: 1px solid var(--border-color); padding-bottom: 14px;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
            <strong>Chị Mai Phương (TP. HCM)</strong>
            <span style="color: var(--text-light); font-size: 0.82rem;">2 ngày trước</span>
          </div>
          <div style="color: var(--accent-warm); font-size: 0.85rem; margin-bottom: 6px;">★★★★★ - Đã mua hàng</div>
          <p style="font-size: 0.92rem; color: var(--text-main);">Nông sản nhận được rất tươi mới, cuống còn xanh lét. Đóng gói cẩn thận bằng hộp giấy tái chế thân thiện môi trường. Rất an tâm cho gia đình dùng!</p>
        </div>

        <div style="border-bottom: 1px solid var(--border-color); padding-bottom: 14px;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
            <strong>Anh Quốc Tuấn (Bình Thạnh)</strong>
            <span style="color: var(--text-light); font-size: 0.82rem;">5 ngày trước</span>
          </div>
          <div style="color: var(--accent-warm); font-size: 0.85rem; margin-bottom: 6px;">★★★★★ - Đã mua hàng</div>
          <p style="font-size: 0.92rem; color: var(--text-main);">Vị ngọt thanh tự nhiên, giòn ngon khác biệt hẳn so với mua ngoài chợ. Shipper giao hàng nhanh và lịch sự.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sản phẩm tương tự cùng loại -->
  <% if (relatedProducts && relatedProducts.length > 0) { %>
    <section class="section">
      <div class="section-header">
        <div>
          <h2 class="section-title">Có Thể Bạn Cũng Thích</h2>
          <p class="section-subtitle">Các nông sản sạch cùng danh mục được nhiều khách hàng chọn mua</p>
        </div>
      </div>

      <div class="products-grid">
        <% relatedProducts.forEach(rel => { %>
          <div class="product-card">
            <div class="product-badge-wrap">
              <span class="badge-cert"><%= rel.certification %></span>
            </div>

            <div class="product-img-holder">
              <a href="/products/<%= rel.id %>">
                <img src="<%= rel.image %>" alt="<%= rel.name %>" class="product-thumb">
              </a>
            </div>

            <div class="product-body">
              <div class="product-origin">
                <i class="fa-solid fa-location-dot"></i> <%= rel.origin %>
              </div>
              <h3 class="product-name">
                <a href="/products/<%= rel.id %>"><%= rel.name %></a>
              </h3>
              <div class="product-rating">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <span>(<%= rel.sold_count %>)</span>
              </div>

              <div class="product-footer">
                <div class="product-price-box">
                  <div class="product-price"><%= Number(rel.price).toLocaleString('vi-VN') %>đ <span class="product-unit">/ <%= rel.unit %></span></div>
                </div>
                <button class="btn-add-cart ajax-add-to-cart" data-product-id="<%= rel.id %>" title="Thêm vào giỏ">
                  <i class="fa-solid fa-cart-plus"></i>
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
</div>

<!-- Modal Tem Nông Sản QR -->
<div id="product-qr-modal" class="modal-overlay">
  <div class="modal-content" style="max-width: 420px; text-align: center;">
    <div class="modal-header">
      <h3 class="modal-title" style="font-size: 1.15rem;">
        <i class="fa-solid fa-stamp" style="color: var(--primary);"></i> Tem Truy Xuất Nông Sản
      </h3>
      <button type="button" class="modal-close" id="close-product-qr-modal">&times;</button>
    </div>

    <!-- Khung tem in tiêu chuẩn -->
    <div id="printable-qr-stamp" style="border: 2px solid var(--primary); border-radius: 12px; padding: 20px; background: #ffffff; margin: 10px 0 20px;">
      <div style="font-weight: 800; color: var(--primary); font-size: 1.1rem; text-transform: uppercase;">
        🌿 <%= product.name %>
      </div>
      <div style="font-size: 0.8rem; color: var(--text-muted); margin: 4px 0 12px;">
        Tiêu chuẩn: <strong><%= product.certification %></strong> | Xuất xứ: <strong><%= product.origin %></strong>
      </div>
      <img src="/products/<%= product.id %>/qrcode" alt="QR Code" style="width: 200px; height: 200px; margin: 0 auto; border-radius: 8px;">
      <div style="font-size: 0.85rem; font-weight: 700; color: var(--primary); margin-top: 10px;">
        QUÉT MÃ ĐỂ XEM CHI TIẾT SẢN PHẨM
      </div>
      <div style="font-size: 0.75rem; color: var(--text-light); margin-top: 2px;">
        Hệ thống phân phối Bình Mỹ Xanh
      </div>
    </div>

    <div style="display: flex; justify-content: center; gap: 10px;">
      <a href="/products/<%= product.id %>/qrcode?download=1" class="btn-primary" style="padding: 10px 20px; font-size: 0.9rem;">
        <i class="fa-solid fa-download"></i> Tải ảnh tem
      </a>
      <button type="button" class="btn-secondary" style="padding: 10px 20px; font-size: 0.9rem;" onclick="window.print()">
        <i class="fa-solid fa-print"></i> In tem
      </button>
    </div>
  </div>
</div>

