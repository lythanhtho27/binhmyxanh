<div class="container" style="padding-top: 20px; padding-bottom: 50px;">
  <!-- Breadcrumb -->
  <div class="breadcrumb">
    <a href="/"><i class="fa-solid fa-house"></i> Trang chủ</a>
    <span>/</span>
    <a href="/products">Sản phẩm</a>
    <span>/</span>
    <a href="/products?category=<%= product.category_id %>"><%= product.category_name %></a>
    <span>/</span>
    <span style="color: var(--primary); font-weight: 600;"><%= product.name %></span>
  </div>

  <!-- Chi Tiết Sản Phẩm (Thiết kế phong cách trang bán sách & sàn TMĐT cao cấp) -->
  <div class="product-detail-wrapper">
    <!-- Hình ảnh sản phẩm -->
    <div class="detail-gallery">
      <div style="position: relative; overflow: hidden; border-radius: var(--radius-md);">
        <img src="<%= product.image %>" alt="<%= product.name %>" class="detail-main-img">
        <div style="position: absolute; top: 16px; left: 16px; display: flex; flex-direction: column; gap: 8px;">
          <span class="badge-cert" style="font-size: 0.82rem; padding: 4px 12px; box-shadow: var(--shadow-sm);"><i class="fa-solid fa-certificate"></i> <%= product.certification %></span>
          <% if (product.is_new) { %>
            <span class="badge-new" style="font-size: 0.82rem; padding: 4px 12px;"><i class="fa-solid fa-sparkles"></i> Mới về</span>
          <% } %>
        </div>
      </div>
      <div style="display: flex; gap: 12px; justify-content: center;">
        <img src="<%= product.image %>" alt="Thumbnail" style="width: 70px; height: 70px; object-fit: cover; border-radius: 8px; border: 2px solid var(--primary); cursor: pointer;">
      </div>

      <!-- Tem QR Truy Xuất Nguồn Gốc Chuẩn VietGAP -->
      <div class="qr-traceability-card">
        <div class="qr-traceability-left">
          <img src="/products/<%= product.id %>/qrcode" alt="QR Code <%= product.name %>" class="qr-traceability-img">
        </div>
        <div class="qr-traceability-right">
          <div class="qr-tag"><i class="fa-solid fa-qrcode"></i> Mã QR Nông Sản</div>
          <p class="qr-desc">Dùng điện thoại quét mã QR để mở nhanh trang chi tiết này hoặc in tem dán lên bao bì.</p>
          <div style="display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap;">
            <a href="/products/<%= product.id %>/qrcode?download=1" class="btn-sm btn-outline-sm" title="Tải ảnh QR về máy">
              <i class="fa-solid fa-download"></i> Tải QR
            </a>
            <button type="button" class="btn-sm btn-outline-sm" id="btn-show-qr-modal" title="Phóng to tem QR">
              <i class="fa-solid fa-expand"></i> Tem in
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Thông tin chi tiết sản phẩm -->
    <div class="detail-info">
      <div class="detail-meta-tags">
        <span style="color: var(--text-muted); font-size: 0.88rem;">
          Danh mục: <a href="/products?category=<%= product.category_id %>" style="color: var(--primary); font-weight: 600;"><%= product.category_name %></a>
        </span>
        <span style="color: var(--border-color);">|</span>
        <span style="color: var(--text-muted); font-size: 0.88rem;">
          Mã nông sản: <strong>NS-<%= product.id.toString().padStart(4, '0') %></strong>
        </span>
      </div>

      <h1 class="detail-title"><%= product.name %></h1>

      <div class="product-rating" style="font-size: 0.95rem; margin-bottom: 12px;">
        <span style="color: var(--accent-warm); font-weight: 700; margin-right: 4px;"><%= product.rating %></span>
        <i class="fa-solid fa-star"></i>
        <i class="fa-solid fa-star"></i>
        <i class="fa-solid fa-star"></i>
        <i class="fa-solid fa-star"></i>
        <i class="fa-solid fa-star"></i>
        <span style="color: var(--text-light); margin-left: 8px;">| Đã bán <%= product.sold_count %> <%= product.unit %></span>
        <span style="color: var(--text-light); margin-left: 8px;">| Tồn kho: <strong style="color: var(--primary);"><%= product.stock %></strong> <%= product.unit %></span>
      </div>

      <!-- Bảng thuộc tính quy cách giống sách / sản phẩm công nghệ -->
      <div class="detail-specs-box">
        <div class="spec-item">
          <span class="spec-label"><i class="fa-solid fa-location-dot" style="color: var(--primary);"></i> Xuất xứ:</span>
          <span class="spec-value"><%= product.origin %></span>
        </div>
        <div class="spec-item">
          <span class="spec-label"><i class="fa-solid fa-calendar-check" style="color: var(--primary);"></i> Thu hoạch:</span>
          <span class="spec-value"><%= product.harvest_date %></span>
        </div>
        <div class="spec-item">
          <span class="spec-label"><i class="fa-solid fa-box-archive" style="color: var(--primary);"></i> Quy cách:</span>
          <span class="spec-value"><%= product.unit %></span>
        </div>
        <div class="spec-item">
          <span class="spec-label"><i class="fa-solid fa-clock-rotate-left" style="color: var(--primary);"></i> Hạn dùng:</span>
          <span class="spec-value"><%= product.shelf_life %></span>
        </div>
      </div>

      <!-- Khung giá bán -->
      <div class="detail-price-panel">
        <div class="detail-price"><%= Number(product.price).toLocaleString('vi-VN') %>đ</div>
        <% if (product.original_price && product.original_price > product.price) { %>
          <div class="detail-old-price"><%= Number(product.original_price).toLocaleString('vi-VN') %>đ</div>
          <div class="detail-discount-percent">Tiết kiệm <%= Math.round((1 - product.price / product.original_price) * 100) %>%</div>
        <% } %>
      </div>

      <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 24px;">
        <%= product.short_description %>
      </p>

      <!-- Nút mua hàng & Chọn số lượng -->
      <div class="detail-actions">
        <div class="qty-control">
          <button type="button" class="qty-btn qty-minus">-</button>
          <input type="number" id="qty-<%= product.id %>" class="qty-input detail-qty-input" value="1" min="1" max="<%= product.stock %>">
          <button type="button" class="qty-btn qty-plus">+</button>
        </div>

        <button type="button" class="btn-primary ajax-add-to-cart" data-product-id="<%= product.id %>" style="padding: 12px 28px;">
          <i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ hàng
        </button>

        <form action="/cart/add" method="POST" style="margin: 0;">
          <input type="hidden" name="productId" value="<%= product.id %>">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="btn-buy-now">
            <i class="fa-solid fa-bolt"></i> Mua ngay
          </button>
        </form>
      </div>

      <div style="display: flex; gap: 20px; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--border-color); font-size: 0.88rem; color: var(--text-muted);">
        <div><i class="fa-solid fa-shield-check" style="color: var(--primary);"></i> Nông sản kiểm nghiệm an toàn</div>
        <div><i class="fa-solid fa-truck-fast" style="color: var(--primary);"></i> Giao hàng tươi mới trong ngày</div>
      </div>
    </div>
  </div>

  <!-- Các tab thông tin chi tiết (Nhật ký canh tác, Giới thiệu, Dinh dưỡng, Bảo quản, Nhận xét) -->
  <section class="detail-tabs-section">
    <div class="tabs-nav">
      <button class="tab-btn active" data-target="tab-farming-log">
        <i class="fa-solid fa-clipboard-check"></i> Nhật ký canh tác
      </button>
      <button class="tab-btn" data-target="tab-desc">
        <i class="fa-solid fa-circle-info"></i> Mô tả sản phẩm
      </button>
      <button class="tab-btn" data-target="tab-nutrition">
        <i class="fa-solid fa-apple-whole"></i> Giá trị dinh dưỡng
      </button>
      <button class="tab-btn" data-target="tab-storage">
        <i class="fa-solid fa-box-archive"></i> Hướng dẫn bảo quản
      </button>
      <button class="tab-btn" data-target="tab-reviews">
        <i class="fa-solid fa-comments"></i> Đánh giá & Nhận xét (5)
      </button>
    </div>

    <!-- Tab Mặc Định: Nhật ký canh tác (Chuẩn VietGAP) -->
    <div id="tab-farming-log" class="tab-pane active">
      <div class="farming-log-container">
        <!-- Banner Tiêu Đề & Mã Truy Xuất Lô -->
        <div class="farming-log-banner">
          <div class="farming-log-badge-group">
            <span class="farming-badge farming-badge-primary">
              <i class="fa-solid fa-certificate"></i> CHUẨN VIETGAP
            </span>
            <span class="farming-badge farming-badge-code">
              <i class="fa-solid fa-barcode"></i> Mã lô: RM-VG-2026-0901
            </span>
            <span class="farming-badge farming-badge-standard">
              <i class="fa-solid fa-shield-halved"></i> Quy chuẩn: TCVN 11892-1:2017
            </span>
          </div>
          <h2 class="farming-log-title">
            <i class="fa-solid fa-book-open-reader" style="color: var(--primary); margin-right: 6px;"></i>
            NHẬT KÝ CANH TÁC RAU MUỐNG (CHUẨN VIETGAP)
          </h2>
          <div class="farming-log-subtitle">
            Mã lô sản xuất: <strong>RM-VG-2026-0901</strong> &nbsp;|&nbsp; Quy chuẩn áp dụng: <strong>TCVN 11892-1:2017</strong>
          </div>
        </div>

        <!-- 1. Thông Tin Nhận Diện & Cơ Sở Canh Tác -->
        <div class="farming-section">
          <h3 class="farming-section-title">
            <i class="fa-solid fa-id-card"></i> 1. Thông Tin Nhận Diện & Cơ Sở Canh Tác
          </h3>
          <div class="farming-table-responsive">
            <table class="farming-table">
              <thead>
                <tr>
                  <th style="width: 280px;"><i class="fa-solid fa-list-check" style="margin-right: 6px;"></i> Chỉ tiêu</th>
                  <th><i class="fa-solid fa-circle-info" style="margin-right: 6px;"></i> Thông tin chi tiết</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="farming-label-cell">
                    <i class="fa-solid fa-building-wheat"></i> Cơ sở sản xuất
                  </td>
                  <td class="farming-value-cell">
                    <strong>Hợp tác xã / Trang trại Nông sản Sạch Xanh</strong>
                  </td>
                </tr>
                <tr>
                  <td class="farming-label-cell">
                    <i class="fa-solid fa-location-dot"></i> Địa chỉ canh tác
                  </td>
                  <td class="farming-value-cell">
                    Thôn/Ấp X, Xã Y, Huyện Z, Tỉnh/TP...
                  </td>
                </tr>
                <tr>
                  <td class="farming-label-cell">
                    <i class="fa-solid fa-map-location-dot"></i> Mã số vùng trồng
                  </td>
                  <td class="farming-value-cell">
                    <span style="display: inline-block; background: #e8f5e9; color: var(--primary-hover); font-weight: 700; padding: 2px 8px; border-radius: 4px; font-family: monospace;">VN-XX-YY-ZZZ</span>
                  </td>
                </tr>
                <tr>
                  <td class="farming-label-cell">
                    <i class="fa-solid fa-chart-area"></i> Diện tích lô canh tác
                  </td>
                  <td class="farming-value-cell">
                    1.000 m² (Lô A2)
                  </td>
                </tr>
                <tr>
                  <td class="farming-label-cell">
                    <i class="fa-solid fa-seedling"></i> Chủng loại cây trồng
                  </td>
                  <td class="farming-value-cell">
                    <strong>Rau muống lá tre</strong> (Hạt giống F1 Trang Nông, tỉ lệ nảy mầm &gt;85%, có chứng nhận kiểm nghiệm kiểm dịch)
                  </td>
                </tr>
                <tr>
                  <td class="farming-label-cell">
                    <i class="fa-solid fa-droplet"></i> Nguồn nước tưới
                  </td>
                  <td class="farming-value-cell">
                    Nước giếng khoan đã qua hệ thống lắng lọc (Đạt chỉ tiêu vi sinh và kim loại nặng theo QCVN 01-1:2018/BYT)
                  </td>
                </tr>
                <tr>
                  <td class="farming-label-cell">
                    <i class="fa-solid fa-user-check"></i> Người phụ trách kỹ thuật
                  </td>
                  <td class="farming-value-cell">
                    Kỹ sư nông học / Cán bộ VietGAP cơ sở
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. Nhật Ký Chi Tiết Vòng Đời Canh Tác (Từng Ngày) -->
        <div class="farming-section">
          <h3 class="farming-section-title">
            <i class="fa-solid fa-timeline"></i> 2. Nhật Ký Chi Tiết Vòng Đời Canh Tác (Từng Ngày)
          </h3>

          <div class="farming-stages-list">
            <!-- Giai đoạn 1 -->
            <div class="farming-stage-card">
              <div class="farming-stage-header">
                <div class="farming-stage-name">
                  <i class="fa-solid fa-tractor" style="color: var(--primary);"></i>
                  Giai đoạn 1: Chuẩn bị đất & Xử lý giá thể
                </div>
                <span class="farming-stage-badge">Ngày 01 – Ngày 03</span>
              </div>
              <div class="farming-stage-body">
                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill">Ngày 01</span>
                    Khử trùng đất & Phơi ải
                  </div>
                  <ul class="farming-action-list">
                    <li>Cày bừa, phơi ải đất nhằm diệt mầm bệnh và trứng sâu tồn dư.</li>
                    <li>Rải vôi nông nghiệp (CaCO<sub>3</sub>) với liều lượng 35 kg/1.000 m² để khử trùng đất và cân bằng độ pH (duy trì pH từ 6.0 – 6.5).</li>
                  </ul>
                </div>

                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill">Ngày 02</span>
                    Bón lót & Phối trộn tầng canh tác
                  </div>
                  <ul class="farming-action-list">
                    <li>
                      Bón lót toàn bộ diện tích:
                      <ul class="farming-action-sublist">
                        <li>Phân chuồng ủ hoai mục bằng chế phẩm nấm đối kháng Trichoderma: 1.200 kg.</li>
                        <li>Phân vi sinh hữu cơ Sông Gianh: 80 kg.</li>
                        <li>Lân nung chảy Lâm Thao: 25 kg.</li>
                      </ul>
                    </li>
                    <li>Bừa đều trộn sâu vào tầng đất canh tác mặt (sâu 15 – 20 cm).</li>
                  </ul>
                </div>

                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill">Ngày 03</span>
                    Lên luống & Tưới ẩm
                  </div>
                  <ul class="farming-action-list">
                    <li>Lên luống: Chiều rộng mặt luống 1,2 m; rãnh thoát nước rộng 30 cm, sâu 20 cm; chiều dài luống 25 m.</li>
                    <li>Làm phẳng bề mặt luống, tưới ẩm đất chuẩn bị gieo.</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Giai đoạn 2 -->
            <div class="farming-stage-card">
              <div class="farming-stage-header">
                <div class="farming-stage-name">
                  <i class="fa-solid fa-wheat-awn" style="color: var(--primary);"></i>
                  Giai đoạn 2: Xử lý hạt & Gieo trồng
                </div>
                <span class="farming-stage-badge">Ngày 04</span>
              </div>
              <div class="farming-stage-body">
                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill">Ngày 04</span>
                    <span class="session-pill"><i class="fa-solid fa-sun"></i> Buổi sáng</span>
                    Xử lý phá miên trạng hạt giống
                  </div>
                  <ul class="farming-action-list">
                    <li>Xử lý hạt giống bằng phương pháp vật lý: Ngâm hạt trong nước ấm theo tỉ lệ 2 sôi : 3 lạnh (khoảng 45°C – 50°C) trong 4 giờ để phá vỡ miên trạng vỏ hạt.</li>
                    <li>Vớt ra, ủ ấm trong vải ẩm 12 giờ cho đến khi hạt nứt nanh đều.</li>
                  </ul>
                </div>

                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill">Ngày 04</span>
                    <span class="session-pill"><i class="fa-solid fa-cloud-sun"></i> Buổi chiều</span>
                    Gieo hạt & Che phủ giữ ẩm
                  </div>
                  <ul class="farming-action-list">
                    <li>Tiến hành gieo hạt theo hàng: Khoảng cách giữa các hàng 15 cm, hạt cách hạt 2 – 3 cm. Lượng hạt sử dụng: 3,5 kg/1.000 m².</li>
                    <li>Phủ một lớp rơm mục / trấu sạch mỏng (dày khoảng 0,5 cm) để giữ ẩm và tránh xói đất khi tưới.</li>
                    <li>Tưới phun sương bằng hệ thống béc tưới tự động, duy trì độ ẩm đất 75 – 80%.</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Giai đoạn 3 -->
            <div class="farming-stage-card">
              <div class="farming-stage-header">
                <div class="farming-stage-name">
                  <i class="fa-solid fa-seedling" style="color: var(--primary);"></i>
                  Giai đoạn 3: Chăm sóc & Cây con phát triển
                </div>
                <span class="farming-stage-badge">Ngày 05 – Ngày 15</span>
              </div>
              <div class="farming-stage-body">
                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill">Ngày 07</span>
                    Cây mầm 2 lá mầm nhú khỏi mặt đất
                  </div>
                  <ul class="farming-action-list">
                    <li>Dỡ bỏ bớt lớp rơm/trấu dày để cây con đón ánh sáng quang hợp.</li>
                    <li>Duy trì tưới nước 2 lần/ngày (sáng sớm trước 8:00 và chiều mát sau 16:30).</li>
                  </ul>
                </div>

                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill">Ngày 10</span>
                    Cây có 2 lá thật & Tưới thúc đợt 1
                  </div>
                  <ul class="farming-action-list">
                    <li>Tỉa dặm những điểm quá dày, nhổ cỏ dại bằng tay dọc theo rãnh luống.</li>
                    <li>Tưới thúc đợt 1: Dùng đạm cá ủ vi sinh (chế phẩm thủy phân hữu cơ) pha loãng theo tỉ lệ 1:300 tưới gốc nhằm kích thích rễ phát triển, thay thế phân đạm vô cơ hòa tan.</li>
                  </ul>
                </div>

                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill">Ngày 14</span>
                    Kiểm tra sâu bệnh IPM định kỳ
                  </div>
                  <ul class="farming-action-list">
                    <li><strong>Ghi nhận:</strong> Xuất hiện bọ nhảy lác đác ở mép bờ luống (dưới ngưỡng gây hại).</li>
                    <li><strong>Biện pháp xử lý sinh học:</strong> Phun dung dịch chiết xuất từ gừng, tỏi, ớt kết hợp dầu khoáng nông nghiệp SK Enspray 99 EC (liều lượng 40 ml/bình 16 lít nước) xua đuổi côn trùng hại lá non. Không sử dụng thuốc trừ sâu hóa học tổng hợp.</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Giai đoạn 4 -->
            <div class="farming-stage-card">
              <div class="farming-stage-header">
                <div class="farming-stage-name">
                  <i class="fa-solid fa-leaf" style="color: var(--primary);"></i>
                  Giai đoạn 4: Thúc sinh trưởng & Kiểm soát an toàn
                </div>
                <span class="farming-stage-badge">Ngày 16 – Ngày 23</span>
              </div>
              <div class="farming-stage-body">
                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill">Ngày 16</span>
                    Bón thúc đợt 2 qua hệ thống tưới
                  </div>
                  <ul class="farming-action-list">
                    <li>Bón thúc đợt 2: Hòa tan 15 kg phân NPK hữu cơ sinh học khoáng (5-5-5 + TE) vào hệ thống tưới nhỏ giọt / tưới tràn mặt luống rãnh nông, sau đó tưới lại bằng nước sạch để tránh cháy lá.</li>
                  </ul>
                </div>

                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill">Ngày 18</span>
                    Làm cỏ thủ công & Xới rãnh luống
                  </div>
                  <ul class="farming-action-list">
                    <li>Làm cỏ thủ công đợt 2, xới nhẹ rãnh luống giúp đất tơi xốp, giữ rễ thông thoáng.</li>
                  </ul>
                </div>

                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill">Ngày 20</span>
                    Đánh giá sinh trưởng & Nguy cơ nấm bệnh
                  </div>
                  <ul class="farming-action-list">
                    <li>Cây đạt chiều cao 15 – 18 cm, thân mập, lá xanh bóng tự nhiên, không có hiện tượng thân xốp ngậm nước do thừa đạm hóa học.</li>
                    <li>Đánh giá nguy cơ nấm bệnh: Luống ráo, thoát nước tốt, không có dấu hiệu bệnh gỉ trắng hay lở cổ rễ.</li>
                  </ul>
                </div>

                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill" style="background: #ffebee; color: var(--accent-red);">Ngày 21</span>
                    Bắt đầu thời kỳ cách ly bắt buộc trước thu hoạch
                  </div>
                  <ul class="farming-action-list">
                    <li>Ngừng tuyệt đối mọi hoạt động bón phân bón lá, phân hữu cơ hay chế phẩm sinh học xua đuổi côn trùng.</li>
                    <li>Chỉ duy trì tưới nước sạch đã qua kiểm định để thanh lọc tồn dư muối khoáng trong mô thực vật và giữ ẩm nhẹ cho cây.</li>
                  </ul>
                  <div class="farming-notice-box">
                    <i class="fa-solid fa-triangle-exclamation" style="color: var(--accent-warm); font-size: 1.1rem; margin-top: 2px;"></i>
                    <div>
                      <strong>Quy chuẩn kiểm soát nghiêm ngặt:</strong> Cách ly tuyệt đối tối thiểu 5 ngày trước thu hoạch nhằm phân giải hoàn toàn các chất dinh dưỡng tự nhiên và bảo đảm độ an toàn sinh học cao nhất cho người tiêu dùng.
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Giai đoạn 5 -->
            <div class="farming-stage-card">
              <div class="farming-stage-header">
                <div class="farming-stage-name">
                  <i class="fa-solid fa-box-open" style="color: var(--primary);"></i>
                  Giai đoạn 5: Thu hoạch & Đóng gói hoàn thiện
                </div>
                <span class="farming-stage-badge">Ngày 25 – Ngày 26</span>
              </div>
              <div class="farming-stage-body">
                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill">Ngày 25</span>
                    Tiền thu hoạch - Kiểm nghiệm chỉ tiêu an toàn
                  </div>
                  <ul class="farming-action-list">
                    <li>Cán bộ kiểm nghiệm lấy mẫu ngẫu nhiên tại ruộng để test nhanh dư lượng Nitrat (NO<sub>3</sub><sup>-</sup>) và hóa chất bảo vệ thực vật.</li>
                    <li><strong>Kết quả:</strong> Âm tính với nhóm thuốc lân hữu cơ/cúc tổng hợp; chỉ số NO<sub>3</sub><sup>-</sup> nằm trong ngưỡng cho phép theo QCVN 8-2:2011/BYT (&lt; 1.500 mg/kg). Cho phép thu hoạch.</li>
                  </ul>
                  <div class="farming-success-box">
                    <i class="fa-solid fa-circle-check" style="color: var(--primary); font-size: 1.1rem; margin-top: 2px;"></i>
                    <div>
                      <strong>Đạt kiểm định xuất vườn:</strong> Chỉ số Nitrat an toàn, không tồn dư hóa chất bảo vệ thực vật. Đủ điều kiện thu hái và dán tem truy xuất nguồn gốc.
                    </div>
                  </div>
                </div>

                <div class="farming-day-item">
                  <div class="farming-day-title">
                    <span class="day-pill">Ngày 26</span>
                    Thu hoạch chính thức & Đóng gói bảo quản
                  </div>
                  <ul class="farming-action-list">
                    <li><strong>Thời gian thu hái:</strong> Từ 5:00 đến 8:00 sáng khi trời còn mát, tránh để rau bị bốc hơi nước gây héo gãy.</li>
                    <li><strong>Dụng cụ:</strong> Dùng dao/kéo inox chuyên dụng đã khử trùng bằng cồn y tế 70°. Cắt cách mặt đất 3 – 4 cm để đảm bảo gốc rau sạch không dính bùn đất.</li>
                    <li>
                      <strong>Phân loại & sơ chế:</strong>
                      <ul class="farming-action-sublist">
                        <li>Chuyển ngay vào nhà sơ chế có mái che, cách ly côn trùng.</li>
                        <li>Nhặt bỏ lá chân vàng úa, rễ sót hoặc cọng dập nát.</li>
                        <li>Rửa qua 2 lần nước sạch luân lưu trên bồn rửa inox đạt chuẩn an toàn thực phẩm, để ráo tự nhiên trên giá thông gió.</li>
                      </ul>
                    </li>
                    <li>
                      <strong>Đóng gói & Niêm phong:</strong>
                      <ul class="farming-action-sublist">
                        <li>Bó rau theo trọng lượng 500g hoặc 1kg bằng lạt nứa/dây tự hủy, bọc màng thở chuyên dụng cho rau củ quả.</li>
                        <li>Dán tem truy xuất nguồn gốc QR Code tích hợp toàn bộ hồ sơ nhật ký lô sản xuất RM-VG-2026-0901.</li>
                        <li>Bảo quản trong kho lạnh nhiệt độ 10°C – 12°C trước khi đưa lên xe lạnh phân phối đến điểm bán lẻ.</li>
                      </ul>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Bản Cam Kết & Minh Chứng An Toàn -->
        <div class="farming-section" style="margin-bottom: 0;">
          <h3 class="farming-section-title">
            <i class="fa-solid fa-award"></i> 3. Bản Cam Kết & Minh Chứng An Toàn
          </h3>
          <div class="farming-commitments-grid">
            <div class="commitment-card">
              <div class="commitment-icon-wrap">
                <i class="fa-solid fa-shield-virus"></i>
              </div>
              <div class="commitment-title">Tồn dư thuốc BVTV</div>
              <p class="commitment-desc">
                Không sử dụng thuốc hóa học độc hại trong suốt chu kỳ sinh trưởng; 100% sử dụng thảo mộc và chế phẩm sinh học.
              </p>
              <div class="commitment-badge">
                <i class="fa-solid fa-circle-check"></i> 100% Thảo mộc & Vi sinh
              </div>
            </div>

            <div class="commitment-card">
              <div class="commitment-icon-wrap">
                <i class="fa-solid fa-hourglass-half"></i>
              </div>
              <div class="commitment-title">Thời gian cách ly</div>
              <p class="commitment-desc">
                Cách ly phân bón và mọi chế phẩm trên 5 ngày trước khi cắt hái.
              </p>
              <div class="commitment-badge">
                <i class="fa-solid fa-circle-check"></i> Cách ly ≥ 5 ngày xuất vườn
              </div>
            </div>

            <div class="commitment-card">
              <div class="commitment-icon-wrap">
                <i class="fa-solid fa-vial-circle-check"></i>
              </div>
              <div class="commitment-title">Vi sinh vật gây bệnh</div>
              <p class="commitment-desc">
                Không phát hiện Salmonella spp., mật độ E. coli đạt giới hạn quy định của VietGAP.
              </p>
              <div class="commitment-badge">
                <i class="fa-solid fa-circle-check"></i> Đạt chuẩn an toàn VietGAP
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 2: Mô tả -->
    <div id="tab-desc" class="tab-pane">
      <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 12px; color: var(--primary);">Câu chuyện nông sản & Quy trình gieo trồng</h3>
      <p style="margin-bottom: 16px;"><%= product.description %></p>
      <p>Tất cả sản phẩm tại Bình Mỹ Xanh đều tuân thủ quy trình canh tác nghiêm ngặt, sử dụng nguồn nước tưới tự nhiên sạch, bón phân hữu cơ sinh học ủ mục và kiểm soát sâu bệnh bằng thiên địch, không dùng chất kích thích sinh trưởng.</p>
    </div>

    <!-- Tab 2: Dinh dưỡng -->
    <div id="tab-nutrition" class="tab-pane">
      <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 12px; color: var(--primary);">Hàm lượng dinh dưỡng & Lợi ích sức khỏe</h3>
      <p style="margin-bottom: 16px;"><%= product.nutrition_info %></p>
      <div style="background: var(--primary-soft); border-left: 4px solid var(--primary); padding: 14px 18px; border-radius: 4px;">
        <strong>Lời khuyên chuyên gia dinh dưỡng:</strong> Bổ sung nông sản hữu cơ đều đặn trong thực đơn hàng ngày giúp tăng cường hệ miễn dịch tự nhiên, ngăn ngừa các bệnh mãn tính và làm chậm quá trình lão hóa tế bào.
      </div>
    </div>

    <!-- Tab 3: Bảo quản -->
    <div id="tab-storage" class="tab-pane">
      <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 12px; color: var(--primary);">Cách bảo quản giữ trọn độ tươi ngon</h3>
      <p style="margin-bottom: 16px;"><%= product.storage_guide %></p>
      <ul style="padding-left: 20px; line-height: 1.8;">
        <li>Nên sơ chế hoặc rửa sạch ngay trước khi nấu ăn để tránh làm hỏng lớp sáp tự nhiên bảo vệ quả/rau.</li>
        <li>Bảo quản trong ngăn rau củ tủ lạnh với độ ẩm lý tưởng từ 85 - 90%.</li>
        <li>Tránh để gần các loại trái cây sinh khí ethylene chín nhanh như chuối chín, táo chín.</li>
      </ul>
    </div>

    <!-- Tab 4: Đánh giá -->
    <div id="tab-reviews" class="tab-pane">
      <div style="display: flex; gap: 40px; margin-bottom: 30px; align-items: center;">
        <div style="text-align: center; background: var(--primary-soft); padding: 24px; border-radius: var(--radius-md); min-width: 160px;">
          <div style="font-size: 3rem; font-weight: 800; color: var(--primary); line-height: 1;"><%= product.rating %></div>
          <div style="color: var(--accent-warm); margin: 6px 0;">★★★★★</div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">5 đánh giá từ khách hàng</div>
        </div>
        <div>
          <h4 style="font-weight: 700; margin-bottom: 8px;">Nhận xét từ khách hàng đã mua:</h4>
          <p style="color: var(--text-muted); font-size: 0.9rem;">100% khách hàng hài lòng về độ tươi ngon và quy cách đóng gói an toàn của sản phẩm này.</p>
        </div>
      </div>

      <!-- Sample reviews -->
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div style="border-bottom: 1px solid var(--border-color); padding-bottom: 14px;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
            <strong>Chị Mai Phương (TP. HCM)</strong>
            <span style="color: var(--text-light); font-size: 0.82rem;">2 ngày trước</span>
          </div>
          <div style="color: var(--accent-warm); font-size: 0.85rem; margin-bottom: 6px;">★★★★★ - Đã mua hàng</div>
          <p style="font-size: 0.92rem; color: var(--text-main);">Nông sản nhận được rất tươi mới, cuống còn xanh lét. Đóng gói cẩn thận bằng hộp giấy tái chế thân thiện môi trường. Rất an tâm cho gia đình dùng!</p>
        </div>

        <div style="border-bottom: 1px solid var(--border-color); padding-bottom: 14px;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
            <strong>Anh Quốc Tuấn (Bình Thạnh)</strong>
            <span style="color: var(--text-light); font-size: 0.82rem;">5 ngày trước</span>
          </div>
          <div style="color: var(--accent-warm); font-size: 0.85rem; margin-bottom: 6px;">★★★★★ - Đã mua hàng</div>
          <p style="font-size: 0.92rem; color: var(--text-main);">Vị ngọt thanh tự nhiên, giòn ngon khác biệt hẳn so với mua ngoài chợ. Shipper giao hàng nhanh và lịch sự.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sản phẩm tương tự cùng loại -->
  <% if (relatedProducts && relatedProducts.length > 0) { %>
    <section class="section">
      <div class="section-header">
        <div>
          <h2 class="section-title">Có Thể Bạn Cũng Thích</h2>
          <p class="section-subtitle">Các nông sản sạch cùng danh mục được nhiều khách hàng chọn mua</p>
        </div>
      </div>

      <div class="products-grid">
        <% relatedProducts.forEach(rel => { %>
          <div class="product-card">
            <div class="product-badge-wrap">
              <span class="badge-cert"><%= rel.certification %></span>
            </div>

            <div class="product-img-holder">
              <a href="/products/<%= rel.id %>">
                <img src="<%= rel.image %>" alt="<%= rel.name %>" class="product-thumb">
              </a>
            </div>

            <div class="product-body">
              <div class="product-origin">
                <i class="fa-solid fa-location-dot"></i> <%= rel.origin %>
              </div>
              <h3 class="product-name">
                <a href="/products/<%= rel.id %>"><%= rel.name %></a>
              </h3>
              <div class="product-rating">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <span>(<%= rel.sold_count %>)</span>
              </div>

              <div class="product-footer">
                <div class="product-price-box">
                  <div class="product-price"><%= Number(rel.price).toLocaleString('vi-VN') %>đ <span class="product-unit">/ <%= rel.unit %></span></div>
                </div>
                <button class="btn-add-cart ajax-add-to-cart" data-product-id="<%= rel.id %>" title="Thêm vào giỏ">
                  <i class="fa-solid fa-cart-plus"></i>
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
</div>

<!-- Modal Tem Nông Sản QR -->
<div id="product-qr-modal" class="modal-overlay">
  <div class="modal-content" style="max-width: 420px; text-align: center;">
    <div class="modal-header">
      <h3 class="modal-title" style="font-size: 1.15rem;">
        <i class="fa-solid fa-stamp" style="color: var(--primary);"></i> Tem Truy Xuất Nông Sản
      </h3>
      <button type="button" class="modal-close" id="close-product-qr-modal">&times;</button>
    </div>

    <!-- Khung tem in tiêu chuẩn -->
    <div id="printable-qr-stamp" style="border: 2px solid var(--primary); border-radius: 12px; padding: 20px; background: #ffffff; margin: 10px 0 20px;">
      <div style="font-weight: 800; color: var(--primary); font-size: 1.1rem; text-transform: uppercase;">
        🌿 <%= product.name %>
      </div>
      <div style="font-size: 0.8rem; color: var(--text-muted); margin: 4px 0 12px;">
        Tiêu chuẩn: <strong><%= product.certification %></strong> | Xuất xứ: <strong><%= product.origin %></strong>
      </div>
      <img src="/products/<%= product.id %>/qrcode" alt="QR Code" style="width: 200px; height: 200px; margin: 0 auto; border-radius: 8px;">
      <div style="font-size: 0.85rem; font-weight: 700; color: var(--primary); margin-top: 10px;">
        QUÉT MÃ ĐỂ XEM CHI TIẾT SẢN PHẨM
      </div>
      <div style="font-size: 0.75rem; color: var(--text-light); margin-top: 2px;">
        Hệ thống phân phối Bình Mỹ Xanh
      </div>
    </div>

    <div style="display: flex; justify-content: center; gap: 10px;">
      <a href="/products/<%= product.id %>/qrcode?download=1" class="btn-primary" style="padding: 10px 20px; font-size: 0.9rem;">
        <i class="fa-solid fa-download"></i> Tải ảnh tem
      </a>
      <button type="button" class="btn-secondary" style="padding: 10px 20px; font-size: 0.9rem;" onclick="window.print()">
        <i class="fa-solid fa-print"></i> In tem
      </button>
    </div>
  </div>
</div>

